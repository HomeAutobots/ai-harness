#!/usr/bin/env bash
# ai-harness: sync
# Harness-owned. Replaced on upgrade, so don't customize it in a project.
#
# Renders the managed blocks in AGENTS.md, renders skills from the libraries into .agents/skills/
# (.agents/lib/libraries.sh resolves them), and maintains tool adapters (instructions, skill
# mirrors, hooks, permissions). Also the CI gate for harness integrity.
#   .agents/bin/sync                                   apply
#   .agents/bin/sync --check                           change nothing; exit 1 if anything is out
#                                                      of date, a pinned skill changed, or an
#                                                      instruction file hides invisible Unicode
#   .agents/bin/sync --lock-skill <name> <source> <ref>   pin a third-party skill by content hash
#   .agents/bin/sync --unshare                         (install.sh --local) strip the harness from
#                                                      tracked shared files, list what to untrack
#
# bash 3.2+ and POSIX tools; python3 renders the JSON configs (hooks, permissions).
set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

PY="$(command -v python3 || true)"
CHECK=0
UNSHARE=0
case "${1:-}" in
  --check) CHECK=1 ;;
  --unshare) UNSHARE=1 ;;
  --lock-skill)
    [ $# -eq 4 ] || { echo "usage: $0 --lock-skill <name> <source> <ref>" >&2; exit 2; }
    [ -n "$PY" ] || { echo "sync: python3 is required to pin skills" >&2; exit 2; }
    exec "$PY" .agents/lib/harness.py lock-skill "$2" "$3" "$4" ;;
  "") ;;
  *) echo "usage: $0 [--check | --unshare | --lock-skill <name> <source> <ref>]" >&2; exit 2 ;;
esac

AGENTS_FILE=AGENTS.md
CORE_SRC=.agents/core/AGENTS.core.md
SKILLS_DIR=.agents/skills

# Defaults. harness.conf overrides them.
ADAPTERS="claude copilot cursor"
LINK_MODE="symlink"
HARNESS_MODE="team"
# shellcheck source=/dev/null
[ -f .agents/harness.conf ] && . ./.agents/harness.conf

DRIFT=0
INFRA=0    # --check: a project-listed library isn't here
CHANGED=0
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

say()   { printf 'sync: %s\n' "$*"; }
warn()  { printf 'sync: warning: %s\n' "$*" >&2; }
die()   { printf 'sync: error: %s\n' "$*" >&2; exit 2; }
drift() { say "out of date: $*"; DRIFT=1; }

tracked() { git ls-files --error-unmatch -- "$1" >/dev/null 2>&1; }
# claude_stub <file>: true if the file holds only what the harness writes (imports, blank lines,
# the marker comment), so regenerating it loses nothing.
CLAUDE_MARK='<!-- Shared instructions live in AGENTS.md'
claude_stub() {
  [ -z "$(grep -vE "^@[^[:space:]]+[[:space:]]*\$|^[[:space:]]*\$|^$CLAUDE_MARK" "$1")" ]
}
# strip_claude <file> <keep-agents>: the file minus the harness's lines (the marker line, the
# blank lines before it, @.agents/AGENTS.local.md, and @AGENTS.md unless keep-agents is 1).
strip_claude() {
  awk -v m="$CLAUDE_MARK" -v keep="$2" '/^@\.agents\/AGENTS\.local\.md[ \t\r]*$/ { next }
       !keep && /^@AGENTS\.md[ \t\r]*$/ { next }
       index($0, m) == 1 { held = ""; next }
       /^[ \t\r]*$/ { held = held $0 "\n"; next }
       { printf "%s", held; held = ""; print }
       END { printf "%s", held }' "$1"
}
LOCAL=0; [ "$HARNESS_MODE" = local ] && LOCAL=1

# --unshare (install.sh --local on a team install): take the harness out of tracked shared files.
# Prints "untrack <path>" for files that are only harness boilerplate; strips the rest in place.
# Runs before the local-mode redirect below: install untracks first, then a plain sync settles.
if [ "$UNSHARE" -eq 1 ]; then
  KEEP_AGENTS=0   # 1: AGENTS.md stays tracked with the project's facts, so imports of it stay too
  if tracked AGENTS.md && [ -f AGENTS.md ]; then
    if grep -q '^> \*\*Not tailored yet\.\*\*' AGENTS.md; then
      echo "untrack AGENTS.md"
    else
      KEEP_AGENTS=1
      # Drop the blocks and the blank lines render_block put around them (held: blank lines seen).
      awk '/<!-- harness:(core|skills):start -->/ { skip = 1; gap = (held != ""); tail = 1; next }
           /<!-- harness:(core|skills):end -->/ { skip = 0; next }
           skip { next }
           /^[ \t\r]*$/ { if (!gap) held = held $0 "\n"; next }
           { printf "%s", held; held = ""; gap = 0; tail = 0; print }
           END { if (!tail) printf "%s", held }' AGENTS.md > "$WORK/agents.md"
      cmp -s AGENTS.md "$WORK/agents.md" || { cat "$WORK/agents.md" > AGENTS.md; echo "stripped AGENTS.md"; }
    fi
  fi
  # CLAUDE.md: only the harness's lines go (its imports and the marker line it writes), and only
  # when the marker says the harness wrote the file. A project's own CLAUDE.md stays as it is.
  if tracked CLAUDE.md && [ -f CLAUDE.md ] && grep -q "^$CLAUDE_MARK" CLAUDE.md; then
    strip_claude CLAUDE.md "$KEEP_AGENTS" > "$WORK/claude.md"
    if ! grep -q '[^[:space:]]' "$WORK/claude.md"; then
      echo "untrack CLAUDE.md"
    elif ! cmp -s CLAUDE.md "$WORK/claude.md"; then
      cat "$WORK/claude.md" > CLAUDE.md; echo "stripped CLAUDE.md"
    fi
  fi
  if [ -n "$PY" ]; then "$PY" .agents/lib/harness.py unshare; fi
  exit 0
fi

# Local mode never modifies a file the project tracks. With a tracked AGENTS.md, the managed
# blocks live in an untracked file of their own, imported by the Claude instructions file.
AGENTS_IN=""   # what the blocks render into; differs from AGENTS_FILE only for --check on a new file
if [ "$LOCAL" -eq 1 ] && tracked AGENTS.md; then
  AGENTS_FILE=.agents/AGENTS.local.md
  if [ ! -f "$AGENTS_FILE" ]; then
    printf '%s\n' '# Harness instructions (local)' '' \
      'This clone runs the AI harness in local mode and the project tracks AGENTS.md, so the harness keeps its instructions here. Project facts from harness-tailor go below the blocks.' \
      > "$WORK/agents.local.md"
    if [ "$CHECK" -eq 1 ]; then AGENTS_IN="$WORK/agents.local.md"; else cp "$WORK/agents.local.md" "$AGENTS_FILE"; fi
  fi
  case " $ADAPTERS " in *" copilot "*|*" cursor "*|*" codex "*)
    [ "$CHECK" -eq 1 ] || warn "the project tracks AGENTS.md, so Copilot, Cursor, and Codex (which read only AGENTS.md) won't see the harness rules in this clone; their hooks still enforce the checks and policy" ;;
  esac
fi

[ -n "$AGENTS_IN" ] || AGENTS_IN="$AGENTS_FILE"
[ -f "$AGENTS_IN" ] || die "no $AGENTS_FILE at repo root. Run install.sh from the ai-harness repo first."
[ -f "$CORE_SRC" ]    || die "missing $CORE_SRC. Re-run install.sh."
[ -f .agents/lib/libraries.sh ] || die "missing .agents/lib/libraries.sh. Re-run install.sh."
export AGENTS_ROOT="$ROOT"
# shellcheck source=../lib/libraries.sh
. .agents/lib/libraries.sh
TAB="$AGENTS_TAB"

# put <target> <generated>: write target only when content differs
put() {
  if [ -f "$1" ] && cmp -s "$1" "$2"; then return 0; fi
  if [ "$CHECK" -eq 1 ]; then drift "$1"; return 0; fi
  mkdir -p "$(dirname "$1")"
  cat "$2" > "$1"
  CHANGED=1
  say "wrote $1"
}

# render_block <name> <body> <in> <out>
# Replaces everything between the block's markers with body. If the markers are
# missing, inserts the block: core goes right after the H1, anything else at the end.
render_block() {
  local name="$1" body="$2" in="$3" out="$4"
  local start="<!-- harness:${name}:start -->" end="<!-- harness:${name}:end -->"
  local ns ne
  ns=$(grep -cF "$start" "$in" || true)
  ne=$(grep -cF "$end" "$in" || true)

  if [ "$ns" -eq 0 ] && [ "$ne" -eq 0 ]; then
    awk -v s="$start" -v e="$end" -v bf="$body" -v mode="$name" '
      function emit(  line) {
        print ""; print s
        while ((getline line < bf) > 0) print line
        close(bf); print e; done = 1
      }
      { print }
      mode == "core" && !done && /^# / { emit(); print "" }
      END { if (!done) emit() }
    ' "$in" > "$out"
    return 0
  fi

  { [ "$ns" -eq 1 ] && [ "$ne" -eq 1 ]; } \
    || die "$AGENTS_FILE needs exactly one '$start' and one '$end'"

  awk -v s="$start" -v e="$end" -v bf="$body" '
    { t = $0; gsub(/^[ \t]+|[ \t\r]+$/, "", t) }
    t == s { print s; while ((getline line < bf) > 0) print line; close(bf); skip = 1; next }
    t == e { skip = 0; print e; next }
    !skip  { print }
  ' "$in" > "$out"
}

# skill_meta <SKILL.md>: prints "name<TAB>description" from YAML frontmatter.
# Handles plain, quoted, and folded (> or |) descriptions.
skill_meta() {
  awk -v q="'" '
    { sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; fm = 1; next }
    fm && $0 == "---" { exit }
    fm {
      if (folding) {
        if ($0 ~ /^[ \t]+[^ \t]/) { v = $0; sub(/^[ \t]+/, "", v); desc = desc (desc == "" ? "" : " ") v; next }
        folding = 0
      }
      if ($0 ~ /^name:/) { name = $0; sub(/^name:[ \t]*/, "", name) }
      else if ($0 ~ /^description:/) {
        desc = $0; sub(/^description:[ \t]*/, "", desc)
        if (desc == "" || desc ~ /^[>|][-+]?$/) { desc = ""; folding = 1 }
      }
    }
    function unquote(v) {
      if (v ~ /^".*"$/ || v ~ ("^" q ".*" q "$")) return substr(v, 2, length(v) - 2)
      return v
    }
    END { printf "%s\t%s\n", unquote(name), unquote(desc) }
  ' "$1"
}

# ---------------------------------------------------------------------------
# 0. Skills from the libraries. .agents/skills/ is their rendered view (most tools read it
#    natively); .claude/skills/ mirrors it.
# ---------------------------------------------------------------------------
shown() { case "$1" in "$ROOT"/*) printf '%s' "${1#"$ROOT"/}" ;; *) printf '%s' "$1" ;; esac; }
# norm_path <path>: . and .. resolved as text (the path needn't exist)
norm_path() {
  printf '%s\n' "$1" | awk '{
    abs = substr($0, 1, 1) == "/"; n = split($0, a, "/"); k = 0
    for (i = 1; i <= n; i++) {
      if (a[i] == "" || a[i] == ".") continue
      if (a[i] == "..") {
        if (k > 0 && s[k] != "..") k--
        else if (!abs) s[++k] = ".."
        continue
      }
      s[++k] = a[i]
    }
    out = ""
    for (i = 1; i <= k; i++) out = out (i > 1 ? "/" : "") s[i]
    if (abs) out = "/" out; else if (out == "") out = "."
    print out
  }'
}
# Every directory a library could be in, as written and physically. Listed ones that are gone
# count too, so the links sync made into them still go as stale.
LIB_PATHS="$WORK/libpaths"
agents_library_paths | while IFS= read -r p; do
  [ -n "$p" ] || continue
  norm_path "$p"
  if [ -d "$p" ]; then (cd "$p" 2>/dev/null && pwd -P) || true; fi
done > "$LIB_PATHS"
# A project-listed library that isn't here (a submodule not checked out): the renders that may be
# its own stay as they are until it's back, so this clone never removes or replaces what the
# project commits. Paths as written, . and .. resolved.
MISSING_LIBS="$WORK/missing-libs"
agents_missing_listed | while IFS= read -r p; do norm_path "$p"; done > "$MISSING_LIBS"
# from_missing <render>: it may come from a missing library: a link into one, or a marked copy when
# a copy could be from one (LINK_MODE=copy, or a missing library outside the repo, which team mode
# copies), since a copy doesn't say where it came from
from_missing() {
  local t
  [ -s "$MISSING_LIBS" ] || return 1
  if [ -L "$1" ]; then
    t="$(readlink "$1")"
    case "$t" in /*) ;; *) t="$ROOT/$(dirname "$1")/$t" ;; esac
    AGENTS_LINK_TARGET="$(norm_path "$t")" \
      awk '{ if (index(ENVIRON["AGENTS_LINK_TARGET"], $0 "/") == 1) f = 1 } END { exit !f }' "$MISSING_LIBS"
    return
  fi
  [ -f "$1/.harness-copy" ] || return 1
  [ "$LINK_MODE" = copy ] && return 0
  AGENTS_ROOT_DIR="$ROOT/" awk '{ if (index($0, ENVIRON["AGENTS_ROOT_DIR"]) != 1) f = 1 } END { exit !f }' "$MISSING_LIBS"
}
# What this clone's sync linked last time (name<TAB>target), so a render still counts after its
# library leaves the search path (taken off LIBRARIES, another personal dir) and goes as stale.
RENDERED_LOG=.agents/cache/rendered-skills
RENDERED_NEW="$WORK/rendered-skills"
: > "$RENDERED_NEW"
# The marked block in the clone's exclude file (see exclude_block). verify reads the same markers.
EXCL_BEGIN="# >>> ai-harness (local install; managed by .agents/bin/sync)"
EXCL_END="# <<< ai-harness"
# Team mode: the personal renders that block lists are sync's too, even with the rendered log
# gone (.agents/cache can be wiped), so none is ever adopted into the shared project library.
EXCL_SKILLS="$WORK/excluded-skills"
: > "$EXCL_SKILLS"
if [ "$LOCAL" -eq 0 ] && ex="$(git rev-parse --git-path info/exclude 2>/dev/null)" && [ -f "$ex" ]; then
  AGENTS_EXCL_PRE="/$(git rev-parse --show-prefix 2>/dev/null | sed 's/[[*?\\]/\\&/g' || true)$SKILLS_DIR/" \
    awk -v b="$EXCL_BEGIN" -v e="$EXCL_END" '$0 == b { f = 1; next } $0 == e { f = 0 }
      f { p = ENVIRON["AGENTS_EXCL_PRE"]; if (index($0, p) == 1) print substr($0, length(p) + 1) }' "$ex" > "$EXCL_SKILLS"
fi
# in_library <link>: it points where sync renders a skill of that name from: <library>/skills/<name>
# or <library>/workflows/<name>/skill (the target read as text, and physically if it exists)
in_library() {
  local t n="${1##*/}"
  t="$(readlink "$1")"
  if [ "${1%/*}" = "$SKILLS_DIR" ] && grep -qxF -- "$n" "$EXCL_SKILLS"; then return 0; fi
  if [ -f "$RENDERED_LOG" ] && AGENTS_LINK_NAME="$n" AGENTS_LINK_TARGET="$t" \
     awk -F '\t' '$1 == ENVIRON["AGENTS_LINK_NAME"] && $2 == ENVIRON["AGENTS_LINK_TARGET"] { f = 1 } END { exit !f }' "$RENDERED_LOG"; then
    return 0
  fi
  case "$t" in /*) ;; *) t="$ROOT/$(dirname "$1")/$t" ;; esac
  t="$(norm_path "$t")"
  { printf '%s\n' "$t"; if [ -d "$t" ]; then (cd "$t" 2>/dev/null && pwd -P) || true; fi; } \
    | AGENTS_LINK_NAME="$n" awk 'NR == FNR { if ($0 != "") lib[++k] = $0; next }
           { n = ENVIRON["AGENTS_LINK_NAME"]
             for (i = 1; i <= k; i++) if ($0 == lib[i] "/skills/" n || $0 == lib[i] "/workflows/" n "/skill") f = 1 }
           END { exit !f }' "$LIB_PATHS" -
}
# rendered <path>: sync made it, a link into a library or a marked copy. Any other link was made
# by hand, and is adopted like a hand-made directory.
rendered() {
  if [ -L "$1" ]; then in_library "$1"; else [ -f "$1/.harness-copy" ]; fi
}
SKILL_SET="$WORK/skills.set"   # what gets rendered: name<TAB>path<TAB>library, by name
: > "$SKILL_SET"
in_set() { awk -F '\t' -v n="$1" '$1 == n { f = 1 } END { exit !f }' "$SKILL_SET"; }
TEAM=$((1 - LOCAL))
personal() { case "$1" in personal|personal-listed) return 0 ;; esac; return 1; }
PERSONAL_LIST="$WORK/personal.list"   # team mode: personal skills rendered for this clone only
: > "$PERSONAL_LIST"
SKILL_ITEMS="$WORK/skills.items"   # compute_skill_set: every library's skills, in winning order
AGENT_ITEMS="$WORK/agents.items"   # every library's agents (and active packs'), in winning order
AGENT_SET="$WORK/agents.set"       # what gets rendered: name<TAB>path<TAB>library
AGENT_RENDERS="$WORK/agents.renders"   # from harness.py agents: shared|personal<TAB>render path
: > "$AGENT_RENDERS"
AGENTS_DONE=0      # harness.py agents finished, so AGENT_RENDERS is complete
AGENT_FINDINGS=0   # --check: an agent file has errors (sync can't fix those)
AGENT_FAILED=0     # --check: rendering agents didn't finish
# Copy renders (render_skills, mirror_skills) to record in generated.lock: path<TAB>source<TAB>
# record|keep. A recorded hash is how sync tells a copy edited by hand from one whose source moved on.
COPY_ROWS="$WORK/copies.rows"
: > "$COPY_ROWS"
# copy_row <path> <source> <library>: list a copy render. Team mode commits the lock, so a personal
# one stays out of it, as personal agent renders do.
copy_row() {
  if [ "$TEAM" -eq 1 ] && personal "$3"; then return 0; fi
  printf '%s\t%s\t%s\n' "$1" "$2" record >> "$COPY_ROWS"
}
# replacing <path> <source>: sync is about to replace a render. A marked copy whose content isn't
# what sync recorded for it was edited by hand, so say so.
replacing() {
  { [ -n "$PY" ] && [ ! -L "$1" ] && [ -f "$1/.harness-copy" ]; } || return 0
  if "$PY" .agents/lib/harness.py copy-edited "$1"; then
    warn "$1 was edited by hand; sync replaced it from $(shown "$2")"
  fi
}

# A skill someone put straight into .agents/skills/ moves to the project library: that dir is
# rendered now, and sync would otherwise remove what it didn't make.
adopt_skills() {
  local d n t
  for d in "$SKILLS_DIR"/*/; do
    d="${d%/}"; n="${d##*/}"
    [ -f "$d/SKILL.md" ] || continue
    rendered "$d" && continue
    agents_valid_name "$n" || continue
    [ "$LOCAL" -eq 1 ] && tracked "$d" && continue   # the project's own; compute_skill_set lists it
    if [ -e ".agents/library/skills/$n" ] || [ -L ".agents/library/skills/$n" ]; then
      # A link move (this one, or install.sh's migration) that stopped after making the library
      # link: both point at the same skill, so the old link is the one left to remove. Not when
      # the library link goes through this one (removing it would leave that one dangling).
      t="$(readlink ".agents/library/skills/$n" 2>/dev/null || true)"
      case "$t" in /*) ;; *) t="$ROOT/.agents/library/skills/$t" ;; esac
      t="$(norm_path "$t")"
      if [ -L "$d" ] && [ -L ".agents/library/skills/$n" ] \
         && case "$t/" in "$ROOT/$d/"*) false ;; *) true ;; esac \
         && t="$(cd "$d" 2>/dev/null && pwd -P)" \
         && [ "$t" = "$(cd ".agents/library/skills/$n" 2>/dev/null && pwd -P)" ]; then
        if [ "$CHECK" -eq 1 ]; then drift "$d (a move to .agents/library/skills/$n that didn't finish)"; continue; fi
        rm -f "$d"
        CHANGED=1
        say "removed the link $d: .agents/library/skills/$n points at the same skill (an earlier move didn't finish)"
        continue
      fi
      warn "$d and .agents/library/skills/$n both exist; keep the one you want in .agents/library/skills/ and delete $d (sync renders .agents/skills/)"
      continue
    fi
    if [ "$CHECK" -eq 1 ]; then drift "$d (added by hand; sync moves it to .agents/library/skills/$n)"; continue; fi
    mkdir -p .agents/library/skills
    if [ -L "$d" ]; then
      # Still a link to the same place: a relative target is rewritten for the new spot.
      t="$(readlink "$d")"
      case "$t" in /*) ;; *) t="$(norm_path "../../skills/$t")" ;; esac
      ln -s "$t" ".agents/library/skills/$n"
      rm -f "$d"
    else
      mv "$d" ".agents/library/skills/$n"
    fi
    CHANGED=1
    say "moved $d to .agents/library/skills/$n (.agents/skills/ is rendered from the libraries)"
  done
}

# The skills to render: first match by name wins. In team mode a personal-only skill renders for
# this clone only: the exclude block keeps it out of git and the committed index leaves it out.
# Local mode never touches what the project tracks, so a skill it keeps in .agents/skills/
# itself stays there and takes its name.
compute_skill_set() {
  local d n p lib
  # Team mode commits what it renders, and that can't depend on anyone's personal library: there
  # the shared ones (project, project-listed, built-in) come first and personal ones after them.
  if [ "$TEAM" -eq 1 ]; then agents_items skills team; else agents_items skills; fi | awk -F '\t' -v team="$TEAM" '
    team && ($3 == "personal" || $3 == "personal-listed") { held[++k] = $0; next }
    { print }
    END { for (i = 1; i <= k; i++) print held[i] }' > "$SKILL_ITEMS"
  awk -F '\t' '!seen[$1]++' "$SKILL_ITEMS" | LC_ALL=C sort > "$WORK/skills.all"
  if [ "$TEAM" -eq 1 ]; then
    while IFS="$TAB" read -r n p lib; do
      if personal "$lib"; then
        if tracked "$SKILLS_DIR/$n" && rendered "$SKILLS_DIR/$n"; then
          from_missing "$SKILLS_DIR/$n" \
            || warn "the project tracks $SKILLS_DIR/$n, a render of your personal skill '$n'; sync removes it (commit that), then renders it for this clone only"
          continue
        elif tracked "$SKILLS_DIR/$n" || tracked ".claude/skills/$n"; then
          warn "your personal skill '$n' isn't rendered here: the project tracks $SKILLS_DIR/$n or .claude/skills/$n"
          continue
        fi
        echo "$n" >> "$PERSONAL_LIST"
      fi
      printf '%s\t%s\t%s\n' "$n" "$p" "$lib" >> "$SKILL_SET"
    done < "$WORK/skills.all"
    return 0
  fi
  cat "$WORK/skills.all" > "$SKILL_SET"
  for d in "$SKILLS_DIR"/*/; do
    d="${d%/}"; n="${d##*/}"
    [ -L "$d" ] && rendered "$d" && continue
    [ -f "$d/SKILL.md" ] || continue
    agents_valid_name "$n" && tracked "$d" || continue
    awk -F '\t' -v n="$n" '$1 != n' "$SKILL_SET" > "$WORK/skills.tmp"
    printf '%s\t%s\t%s\n' "$n" "$ROOT/$d" tracked >> "$WORK/skills.tmp"
    LC_ALL=C sort "$WORK/skills.tmp" > "$SKILL_SET"
  done
}

# The agents to render: first match by name wins; in team mode the shared ones come first, as for
# skills, so what's committed is the same on every machine.
compute_agent_set() {
  if [ "$TEAM" -eq 1 ]; then agents_items agents team; else agents_items agents; fi | awk -F '\t' -v team="$TEAM" '
    team && ($3 == "personal" || $3 == "personal-listed") { held[++k] = $0; next }
    { print }
    END { for (i = 1; i <= k; i++) print held[i] }' > "$AGENT_ITEMS"
  awk -F '\t' '!seen[$1]++' "$AGENT_ITEMS" > "$AGENT_SET"
}

# keep_missing: each render that may come from a missing project-listed library (from_missing)
# stays as it is: it joins the set as "kept", in place of what would replace it. A winner from the
# project library, or from a project-listed one listed before the first missing one, still takes
# over (the missing one would lose to it anyway); any other winner doesn't, since the missing
# library might have come first.
KEPT="$WORK/kept"
: > "$KEPT"
LISTED_LIBS="$WORK/listed-libs"   # project-listed libraries in LIBRARIES order, as text
agents_library_candidates | awk -F '\t' '$1 == "project-listed" { print $2 }' \
  | while IFS= read -r p; do norm_path "$p"; done > "$LISTED_LIBS"
FIRST_MISSING="$(awk 'NR == FNR { miss[$0] = 1; next } ($0 in miss) { print FNR; exit }' "$MISSING_LIBS" "$LISTED_LIBS")"
keep_missing() {
  local target name line wsrc i
  [ -s "$MISSING_LIBS" ] && [ -d "$SKILLS_DIR" ] || return 0
  for target in "$SKILLS_DIR"/*; do
    { [ -e "$target" ] || [ -L "$target" ]; } || continue
    name="${target##*/}"
    agents_valid_name "$name" && rendered "$target" && from_missing "$target" || continue
    line="$(awk -F '\t' -v n="$name" '$1 == n' "$SKILL_SET")"
    if [ -n "$line" ]; then
      case "${line##*"$TAB"}" in
        project|tracked) continue ;;
        project-listed)   # only from a library listed before the first missing one
          wsrc="${line#*"$TAB"}"; wsrc="$(norm_path "${wsrc%"$TAB"*}")"
          i="$(AGENTS_WINNER="$wsrc" awk 'index(ENVIRON["AGENTS_WINNER"], $0 "/") == 1 { print NR; exit }' "$LISTED_LIBS")"
          if [ -n "$i" ] && [ "$i" -lt "$FIRST_MISSING" ]; then continue; fi ;;
      esac
    fi
    echo "$name" >> "$KEPT"
    if [ -L "$target" ]; then printf '%s\t%s\n' "$name" "$(readlink "$target")" >> "$RENDERED_NEW"; fi
  done
  [ -s "$KEPT" ] || return 0
  { awk -F '\t' 'NR == FNR { k[$0] = 1; next } !($1 in k)' "$KEPT" "$SKILL_SET"
    while IFS= read -r name; do printf '%s\t%s\t%s\n' "$name" "$ROOT/$SKILLS_DIR/$name" kept; done < "$KEPT"
  } | LC_ALL=C sort > "$WORK/skills.tmp"
  cat "$WORK/skills.tmp" > "$SKILL_SET"
  awk 'NR == FNR { k[$0] = 1; next } !($0 in k)' "$KEPT" "$PERSONAL_LIST" > "$WORK/personal.tmp"
  cat "$WORK/personal.tmp" > "$PERSONAL_LIST"
}

# The same name in two libraries: the higher one wins, with a warning naming both. Workflows and
# stacks only matter while they're active.
# Skills and agents go by their items files, so in team mode a personal one that loses to a shared
# one gets its own message (once per name) instead.
report_shadows() {  # report_shadows <kind> <ALL | active names>
  local n ws wp lsrc lpath told=" " items=""
  case "$1" in skills) items="$SKILL_ITEMS" ;; agents) items="$AGENT_ITEMS" ;; esac
  if [ -n "$items" ]; then
    awk -F '\t' '($1 in wp) { printf "%s\t%s\t%s\t%s\t%s\n", $1, ws[$1], wp[$1], $3, $2; next }
                 { wp[$1] = $2; ws[$1] = $3 }' "$items"
  else
    agents_shadows "$1"
  fi | while IFS="$TAB" read -r n ws wp lsrc lpath; do
    [ "$2" = ALL ] || case " $2 " in *" $n "*) ;; *) continue ;; esac
    # Team mode, a personal workflow over a shared one: one message for both, from the loop below.
    if [ "$TEAM" -eq 1 ] && personal "$lsrc" && ! personal "$ws"; then
      case "$1:$lpath" in "skills:"*/workflows/"$n"/skill) continue ;; esac
    fi
    if [ "$TEAM" -eq 1 ] && [ "$1" = workflows ] && personal "$ws" && ! personal "$lsrc"; then continue; fi
    if [ "$TEAM" -eq 1 ] && { [ "$1" = skills ] || [ "$1" = agents ]; } && personal "$lsrc" && ! personal "$ws"; then
      case "$told" in *" $n "*) continue ;; esac
      told="$told$n "
      warn "your personal ${1%s} '$n' isn't used in team mode ($(shown "$lpath")): the repo commits the shared one from $ws, so everyone gets the same. Give yours another name to use both."
      continue
    fi
    warn "${1%s} '$n' from the $ws library ($(shown "$wp")) shadows the one in $lsrc ($(shown "$lpath"))"
  done
}

# render_skills: .agents/skills/<name> for each skill in the set. A relative link for a source
# inside the project, an absolute one outside it; a copy with LINK_MODE=copy, or when team mode
# commits a shared skill from outside the repo (a link there can't be committed).
render_skills() {
  local name src lib target rel copy how
  while IFS="$TAB" read -r name src lib; do
    target="$SKILLS_DIR/$name"
    if [ "$src" = "$ROOT/$target" ]; then   # a tracked skill in place (local mode), or kept
      # a kept copy holds its record until its library is back
      if [ "$lib" = kept ] && [ ! -L "$target" ] && [ -f "$target/.harness-copy" ]; then
        printf '%s\t%s\t%s\n' "$target" "$src" keep >> "$COPY_ROWS"
      fi
      continue
    fi
    copy=0; [ "$LINK_MODE" = copy ] && copy=1
    case "$src" in
      "$ROOT"/*) rel="../../${src#"$ROOT"/}" ;;
      *) rel="$src"
         if [ "$LOCAL" -eq 0 ]; then case "$lib" in personal|personal-listed) ;; *) copy=1 ;; esac; fi ;;
    esac
    if [ "$LOCAL" -eq 1 ] && tracked "$target"; then
      warn "$target is tracked by the project; local mode leaves it alone"
      continue
    fi
    if { [ -e "$target" ] || [ -L "$target" ]; } && ! rendered "$target"; then
      warn "$target wasn't made by sync, leaving it alone (move it into .agents/library/skills/ if it's yours)"
      continue
    fi
    if [ "$copy" -eq 1 ]; then
      copy_row "$target" "$src" "$lib"
      if [ ! -L "$target" ] && [ -d "$target" ] \
         && diff -rq -x .harness-copy -x __pycache__ -x .DS_Store "$src" "$target" >/dev/null 2>&1; then continue; fi
    else
      if [ -L "$target" ] && [ "$(readlink "$target")" = "$rel" ]; then printf '%s\t%s\n' "$name" "$rel" >> "$RENDERED_NEW"; continue; fi
    fi
    if [ "$CHECK" -eq 1 ]; then drift "$target"; continue; fi
    mkdir -p "$SKILLS_DIR"
    replacing "$target" "$src"
    rm -rf "$target"
    if [ "$copy" -eq 1 ]; then
      mkdir -p "$target"
      cp -R "$src/." "$target/"
      : > "$target/.harness-copy"
      how=copy
    else
      ln -s "$rel" "$target"
      printf '%s\t%s\n' "$name" "$rel" >> "$RENDERED_NEW"
      how="link"
    fi
    CHANGED=1
    say "rendered $target ($how)"
  done < "$SKILL_SET"
  # Remove renders whose skill no longer resolves.
  [ -d "$SKILLS_DIR" ] || return 0
  for target in "$SKILLS_DIR"/*; do
    { [ -e "$target" ] || [ -L "$target" ]; } || continue
    name="${target##*/}"
    in_set "$name" && continue
    rendered "$target" || continue
    [ "$LOCAL" -eq 1 ] && tracked "$target" && continue
    if [ "$CHECK" -eq 1 ]; then drift "$target (stale)"; continue; fi
    rm -rf "$target"
    CHANGED=1
    say "removed stale $target"
  done
  if [ "$CHECK" -eq 0 ] && ! cmp -s "$RENDERED_NEW" "$RENDERED_LOG"; then
    mkdir -p .agents/cache && cat "$RENDERED_NEW" > "$RENDERED_LOG"
  fi
}

# .agents/commands/<name>: a stable path for each command an active workflow pack ships in bin/.
# Packs run in place from whichever library has them, so the wrapper finds the pack when it runs:
# the same file on every machine. A file there without the marker isn't sync's.
CMD_DIR=.agents/commands
CMD_MARK="# generated by .agents/bin/sync:"
cmd_wrapper() {  # cmd_wrapper <command> <workflow>
  cat <<EOF
#!/usr/bin/env bash
$CMD_MARK runs bin/$1 from the active workflow pack '$2', wherever its library is. Edit the pack, not this file.
root="\$(cd "\$(dirname "\$0")/../.." && pwd)"
line="\$(AGENTS_ROOT="\$root" bash "\$root/.agents/lib/libraries.sh" resolve workflows $2 2>/dev/null)" || line=""
pack="\$(printf '%s\n' "\$line" | cut -f2)"
if [ -z "\$pack" ] || [ ! -x "\$pack/bin/$1" ]; then
  echo "$1: infra: no library here has the workflow pack '$2' with bin/$1 (see .agents/library/README.md)" >&2
  exit 3
fi
export AGENTS_ROOT="\$root"   # a pack outside the project finds the project by this
exec "\$pack/bin/$1" "\$@"
EOF
}
# Team mode commits the wrappers, so what's committed can't depend on anyone's personal library:
# when a personal pack wins, the shared pack's commands are listed (committed) and the personal
# pack's own ones are this clone's only (COMMANDS_PERSONAL, in the exclude block).
COMMANDS_PERSONAL="$WORK/commands.personal"
: > "$COMMANDS_PERSONAL"
cmd_want() {  # cmd_want <workflow> <pack> <shared|personal>: the pack's bin/ commands
  local f n first
  [ -d "$2/bin" ] || return 0
  for f in "$2"/bin/*; do
    { [ -f "$f" ] && [ -x "$f" ]; } || continue
    n="${f##*/}"
    agents_valid_name "$n" || continue
    first="$(awk -F '\t' -v n="$n" '$1 == n { print $2; exit }' "$WORK/commands.want")"
    if [ -n "$first" ]; then
      [ "$first" = "$1" ] || warn "workflows '$first' and '$1' both ship bin/$n; $CMD_DIR/$n runs the one from '$first'"
      continue
    fi
    printf '%s\t%s\n' "$n" "$1" >> "$WORK/commands.want"
    if [ "$3" = personal ]; then echo "$n" >> "$COMMANDS_PERSONAL"; fi
  done
}
render_commands() {
  local w p line src shared n target seen=" " ws=()
  : > "$WORK/commands.want"
  set -f; for w in ${WORKFLOWS:-}; do ws+=("$w"); done; set +f
  for w in "${ws[@]+"${ws[@]}"}"; do
    case "$seen" in *" $w "*) continue ;; esac
    seen="$seen$w "
    agents_valid_name "$w" || continue
    line="$(agents_lookup workflows "$w" 2>/dev/null)" || continue
    src="${line##*"$TAB"}"; p="${line#*"$TAB"}"; p="${p%"$TAB"*}"
    if [ "$TEAM" -eq 1 ] && personal "$src"; then
      if shared="$(agents_shared_workflow "$w")"; then cmd_want "$w" "${shared#*"$TAB"}" shared; fi
      cmd_want "$w" "$p" personal
    else
      cmd_want "$w" "$p" shared
    fi
  done
  while IFS="$TAB" read -r n w; do
    target="$CMD_DIR/$n"
    if [ "$LOCAL" -eq 1 ] && tracked "$target"; then
      warn "$target is tracked by the project; local mode leaves it alone"
      continue
    fi
    if { [ -e "$target" ] || [ -L "$target" ]; } && { [ -L "$target" ] || ! grep -qF "$CMD_MARK" "$target" 2>/dev/null; }; then
      warn "$target wasn't made by sync, leaving it alone (workflow '$w' ships bin/$n too)"
      continue
    fi
    cmd_wrapper "$n" "$w" > "$WORK/cmd"
    if [ -f "$target" ] && [ -x "$target" ] && cmp -s "$target" "$WORK/cmd"; then continue; fi
    if [ "$CHECK" -eq 1 ]; then drift "$target"; continue; fi
    mkdir -p "$CMD_DIR"
    cat "$WORK/cmd" > "$target"
    chmod +x "$target"
    CHANGED=1
    say "wrote $target"
  done < "$WORK/commands.want"
  [ -d "$CMD_DIR" ] || return 0
  for target in "$CMD_DIR"/*; do
    [ -f "$target" ] && [ ! -L "$target" ] || continue
    n="${target##*/}"
    grep -qF "$CMD_MARK" "$target" 2>/dev/null || continue
    if awk -F '\t' -v n="$n" '$1 == n { f = 1 } END { exit !f }' "$WORK/commands.want"; then continue; fi
    if [ "$LOCAL" -eq 1 ] && tracked "$target"; then continue; fi
    if [ "$CHECK" -eq 1 ]; then drift "$target (stale)"; continue; fi
    rm -f "$target"
    CHANGED=1
    say "removed stale $target"
  done
  # Only an empty dir goes, so a hand-made command keeps it; --check changes nothing.
  [ "$CHECK" -eq 1 ] || rmdir "$CMD_DIR" 2>/dev/null || true
}

adopt_skills
compute_skill_set
keep_missing
report_shadows skills ALL
report_shadows workflows "${WORKFLOWS:-}"
report_shadows stacks "${STACKS:-}"
compute_agent_set
report_shadows agents ALL
# Something shaped like an item that isn't one (an empty pack directory, a skill without SKILL.md)
# is ignored by the resolver, so it can't shadow a working one; say so. Packs only while active.
report_unusable() {  # report_unusable <kind> <ALL | active names> <what it lacks>
  local n p
  agents_unusable "$1" | while IFS="$TAB" read -r n p _; do
    [ "$2" = ALL ] || case " $2 " in *" $n "*) ;; *) continue ;; esac
    warn "$(shown "$p") isn't a usable ${1%s} ($3); ignored"
  done
}
report_unusable skills ALL "no SKILL.md"
report_unusable workflows "${WORKFLOWS:-}" "no checks/ with a file, skill/SKILL.md, agents/, mcp/, bin/, a snippet, or seed/ with a file"
report_unusable stacks "${STACKS:-}" "no lib.sh or checks/ with a file"
report_unusable agents ALL "empty"
report_unusable mcp ALL "empty"
# A LIBRARIES entry that isn't there. A personal-listed one is skipped with a warning. A project-
# listed one is the project's config (a submodule not checked out, say): its renders stay (see
# keep_missing), and --check fails, so CI notices instead of passing without it.
while IFS="$TAB" read -r lsrc lp; do
  case "$lsrc" in
    project-listed)
      # missing as the resolver sees it: no directory, or an empty one (a submodule not checked out)
      grep -qxF -- "$(norm_path "$lp")" "$MISSING_LIBS" || continue
      if [ "$CHECK" -eq 1 ]; then
        say "infra: LIBRARIES lists $(shown "$lp"), which isn't here (an uninitialized submodule?); its skills and packs can't be checked"
        INFRA=1
      elif [ "$TEAM" -eq 1 ]; then
        warn "LIBRARIES lists $(shown "$lp"), which isn't here (an uninitialized submodule?); its skills and agents keep their committed renders until it's back"
      else
        warn "LIBRARIES lists $(shown "$lp"), which isn't here (an uninitialized submodule?); its skills and agents keep their renders until it's back"
      fi ;;
    personal-listed) [ -d "$lp" ] || warn "LIBRARIES ($lsrc) names $(shown "$lp"), which isn't there; its skills and packs are skipped" ;;
  esac
done < <(agents_library_candidates)
MISSING_NOTE="$(agents_missing_note)"
set -f   # the names are split on spaces; a glob character stays literal
for w in ${WORKFLOWS:-}; do
  agents_resolve workflows "$w" >/dev/null && continue
  if [ -n "$MISSING_NOTE" ]; then warn "WORKFLOWS lists '$w', which no library here has, and $MISSING_NOTE; verify and gitflow stop with a tooling problem until it's back"
  else warn "WORKFLOWS lists '$w', but no library has it; its checks and skill are skipped"; fi
done
for s in ${STACKS:-}; do
  agents_resolve stacks "$s" >/dev/null && continue
  if [ -n "$MISSING_NOTE" ]; then warn "STACKS lists '$s', which no library here has, and $MISSING_NOTE; verify stops with a tooling problem until it's back"
  else warn "STACKS lists '$s', but no library has it; tier scripts that source .agents/stacks/$s/lib.sh stop with a tooling problem"; fi
done
if [ "$TEAM" -eq 1 ]; then
  for w in ${WORKFLOWS:-}; do
    l="$(agents_lookup workflows "$w")" || continue
    personal "${l##*"$TAB"}" || continue
    # Your pack runs here (the resolver's order), but what team mode renders is committed, so the
    # skill comes from the shared pack everyone else runs.
    if sw="$(agents_shared_workflow "$w")"; then
      if [ -f "${sw#*"$TAB"}/skill/SKILL.md" ]; then
        warn "your personal workflow '$w' runs its checks here, but team mode renders the skill from the ${sw%%"$TAB"*} library ($(shown "${sw#*"$TAB"}/skill")): the repo commits that one, and teammates and CI run that pack"
      else
        warn "your personal workflow '$w' runs its checks here; teammates and CI run the one from the ${sw%%"$TAB"*} library ($(shown "${sw#*"$TAB"}"))"
      fi
    else
      warn "workflow '$w' comes from your personal library; teammates and CI without it skip its checks"
    fi
  done
fi
set +f
render_skills
render_commands

# ---------------------------------------------------------------------------
# 1. AGENTS.md managed blocks
# ---------------------------------------------------------------------------
CORE_BODY="$WORK/core.md"
{
  printf '<!-- Managed by ai-harness via .agents/bin/sync. Edits inside this block get overwritten. -->\n\n'
  cat "$CORE_SRC"
} > "$CORE_BODY"

SKILLS_BODY="$WORK/skills.md"
{
  echo "## Skills index"
  echo "Generated by \`.agents/bin/sync\` from the skill libraries into \`.agents/skills/\`. If your tool doesn't load skills on its own, read \`.agents/skills/<name>/SKILL.md\` before starting that kind of task."
  echo
  found=0
  while IFS="$TAB" read -r dname src lib; do
    if [ "$lib" = kept ]; then
      # its library isn't here: the index keeps the line it has, so it stays the same for everyone
      kl="$(AGENTS_SKILL_LINE="- \`$dname\`: " awk 'index($0, ENVIRON["AGENTS_SKILL_LINE"]) == 1 { print; exit }' "$AGENTS_IN")"
      if [ -n "$kl" ]; then printf '%s\n' "$kl"; found=1; continue; fi
    fi
    f="$src/SKILL.md"
    [ -f "$f" ] || continue
    meta="$(skill_meta "$f")"
    sname="${meta%%$'\t'*}"
    sdesc="${meta#*$'\t'}"
    [ -n "$sname" ] || warn "$(shown "$f") has no 'name' in its frontmatter"
    [ -z "$sname" ] || [ "$sname" = "$dname" ] \
      || warn "$(shown "$f"): name '$sname' doesn't match '$dname' (the Agent Skills spec requires a match)"
    [ -n "$sdesc" ] || warn "$(shown "$f") has no 'description', so agents won't know when to use it"
    [ "$TEAM" -eq 0 ] || ! personal "$lib" || continue   # the committed index is the same for everyone
    echo "- \`$dname\`: $sdesc"
    found=1
  done < "$SKILL_SET"
  [ "$found" -eq 1 ] || echo "_No skills yet._"
} > "$SKILLS_BODY"

# Local mode hides an untracked AGENTS.md from git. One that was already here before the harness
# (no harness blocks yet) is someone's own file, so say so once, as the blocks go in.
if [ "$LOCAL" -eq 1 ] && [ "$CHECK" -eq 0 ] && [ "$AGENTS_FILE" = AGENTS.md ] \
   && ! grep -qF '<!-- harness:core:start -->' AGENTS.md; then
  warn "AGENTS.md was here before the harness and git doesn't track it, so local mode now hides it from git status too. To share it, take the harness blocks out, commit it, and re-run sync."
fi
render_block core   "$CORE_BODY"   "$AGENTS_IN" "$WORK/step1.md"
render_block skills "$SKILLS_BODY" "$WORK/step1.md" "$WORK/step2.md"
put "$AGENTS_FILE" "$WORK/step2.md"

# ---------------------------------------------------------------------------
# 2. Adapters
# ---------------------------------------------------------------------------

# owned <path>: true if the harness created it (our symlink or a marked copy)
owned() {
  if [ -L "$1" ]; then
    case "$(readlink "$1")" in "../../$SKILLS_DIR/"*) return 0 ;; esac
    return 1
  fi
  [ -f "$1/.harness-copy" ]
}

# mirror_skills <tool-skills-dir>: expose each rendered skill in a tool's own skills dir
mirror_skills() {
  local dest="$1" name src lib target rel
  while IFS="$TAB" read -r name src lib; do
    target="$dest/$name"
    rel="../../$SKILLS_DIR/$name"

    if [ "$LOCAL" -eq 1 ] && tracked "$target"; then
      warn "$target is tracked by the project; local mode leaves it alone"
      continue
    fi

    if { [ -e "$target" ] || [ -L "$target" ]; } && ! owned "$target"; then
      warn "$target already exists and wasn't made by the harness, leaving it alone"
      continue
    fi

    if [ "$LINK_MODE" = copy ]; then
      copy_row "$target" "$src" "$lib"
      if [ ! -L "$target" ] && [ -d "$target" ] \
         && diff -rq -x .harness-copy -x __pycache__ -x .DS_Store "$src" "$target" >/dev/null 2>&1; then continue; fi
    else
      if [ -L "$target" ] && [ "$(readlink "$target")" = "$rel" ]; then continue; fi
    fi

    if [ "$CHECK" -eq 1 ]; then drift "$target"; continue; fi
    mkdir -p "$dest"
    if [ "$LINK_MODE" = copy ]; then replacing "$target" "$src"; else replacing "$target" "$ROOT/$SKILLS_DIR/$name"; fi
    rm -rf "$target"
    if [ "$LINK_MODE" = copy ]; then
      mkdir -p "$target"
      cp -R "$src/." "$target/"
      : > "$target/.harness-copy"
    else
      ln -s "$rel" "$target"
    fi
    CHANGED=1
    say "mirrored $target ($LINK_MODE)"
  done < "$SKILL_SET"

  # Remove harness-made entries whose skill no longer renders.
  [ -d "$dest" ] || return 0
  for target in "$dest"/*; do
    { [ -e "$target" ] || [ -L "$target" ]; } || continue
    name="$(basename "$target")"
    in_set "$name" && continue
    owned "$target" || continue
    [ "$LOCAL" -eq 1 ] && tracked "$target" && continue
    if [ "$CHECK" -eq 1 ]; then drift "$target (stale)"; continue; fi
    rm -rf "$target"
    CHANGED=1
    say "removed stale $target"
  done
}

adapter_claude() {
  # An @import works on every Claude Code setup. The built-in AGENTS.md fallback only kicks in
  # with no CLAUDE.md present (any CLAUDE*.md counts) and isn't available on every provider.
  local cf=CLAUDE.md imports="@AGENTS.md"
  if [ "$LOCAL" -eq 1 ]; then
    if tracked CLAUDE.md; then
      cf=CLAUDE.local.md
      grep -qE '^@AGENTS\.md[[:space:]]*$' CLAUDE.md && imports=""
    fi
    [ "$AGENTS_FILE" = AGENTS.md ] || imports="${imports:+$imports }@$AGENTS_FILE"
  fi
  if [ "$LOCAL" -eq 1 ] && [ "$cf" != CLAUDE.md ] && tracked "$cf"; then
    warn "$cf is tracked by the project; local mode leaves it alone"
    imports=""
  fi
  # Nothing to import (the tracked CLAUDE.md already imports AGENTS.md, which holds the blocks):
  # no personal file needed.
  if [ -n "$imports" ]; then
    # A stub keeps imports someone added (existing order first); the harness's own two imports
    # stay only while they're wanted.
    : > "$WORK/claude.md"
    if [ -f "$cf" ] && claude_stub "$cf"; then
      sed -n 's/^\(@[^[:space:]]*\)[[:space:]]*$/\1/p' "$cf" | while IFS= read -r i; do
        case "$i" in @AGENTS.md|@.agents/AGENTS.local.md) case " $imports " in *" $i "*) ;; *) continue ;; esac ;; esac
        grep -qxF -- "$i" "$WORK/claude.md" || printf '%s\n' "$i" >> "$WORK/claude.md"
      done
    fi
    for i in $imports; do grep -qxF -- "$i" "$WORK/claude.md" || printf '%s\n' "$i" >> "$WORK/claude.md"; done
    printf '%s\n' '' "$CLAUDE_MARK. Claude Code-only notes go below this line. -->" >> "$WORK/claude.md"
    if [ ! -f "$cf" ] || claude_stub "$cf"; then
      put "$cf" "$WORK/claude.md"
    else
      for i in $imports; do
        grep -qxF "$i" "$cf" \
          || warn "$cf doesn't import ${i#@}, so Claude Code won't see the harness. Run the harness-tailor skill to fold it in, or add '$i' as a line."
      done
    fi
  fi
  # A CLAUDE.local.md the harness made (marker line) that isn't wanted any more (team mode, or the
  # tracked CLAUDE.md now imports AGENTS.md itself) would load AGENTS.md twice. Only the harness's
  # lines go; the file goes only if nothing else is left.
  if [ -f CLAUDE.local.md ] && grep -q "^$CLAUDE_MARK" CLAUDE.local.md \
     && ! { [ "$LOCAL" -eq 1 ] && { { [ "$cf" = CLAUDE.local.md ] && [ -n "$imports" ]; } || tracked CLAUDE.local.md; }; }; then
    strip_claude CLAUDE.local.md 0 > "$WORK/claude.local.md"
    if grep -q '[^[:space:]]' "$WORK/claude.local.md"; then
      put CLAUDE.local.md "$WORK/claude.local.md"
    elif [ "$CHECK" -eq 1 ]; then drift "CLAUDE.local.md (remove)"
    else rm -f CLAUDE.local.md; CHANGED=1; say "removed CLAUDE.local.md (CLAUDE.md imports AGENTS.md)"; fi
  fi
  mirror_skills .claude/skills
}

for a in $ADAPTERS; do
  case "$a" in
    claude) adapter_claude ;;
    copilot|cursor|codex|gemini) ;;  # rendered by harness.py below
    *) warn "unknown adapter '$a' in .agents/harness.conf" ;;
  esac
done

# JSON configs: hooks, permission rules, Codex execpolicy, Gemini context. Merged into files the
# project may already own; only entries the harness added are replaced.
if [ -n "$PY" ]; then
  RENDER_RC=0
  if [ "$CHECK" -eq 1 ]; then
    "$PY" .agents/lib/harness.py render --check || RENDER_RC=$?
    [ "$RENDER_RC" -eq 0 ] || DRIFT=1
  else
    OUT="$("$PY" .agents/lib/harness.py render)" || RENDER_RC=$?
    [ -n "$OUT" ] && { printf '%s\n' "$OUT"; CHANGED=1; }
    [ "$RENDER_RC" -eq 0 ] || warn "adapter rendering reported errors (see above)"
  fi
  # A kept render's library isn't here, so a pin on it can't be checked; check-skills says it's missing.
  awk -F '\t' '$3 != "kept"' "$SKILL_SET" > "$WORK/skills.checked"
  "$PY" .agents/lib/harness.py check-skills "$WORK/skills.checked" || DRIFT=1
  # Library agents, one render per adapter. With a project-listed library missing, renders that
  # may be its own stay as committed until it's back. It returns 0 ok, 1 drift, 5 agent-file
  # errors (drift lines still printed); anything else, or no renders file, means it didn't finish.
  AG_RC=0
  agmiss=0
  if [ -s "$MISSING_LIBS" ]; then agmiss=1; fi
  rm -f "$AGENT_RENDERS"
  if [ "$CHECK" -eq 1 ]; then
    AOUT="$(AGENTS_LIBRARY_MISSING="$agmiss" "$PY" .agents/lib/harness.py agents --check "$AGENT_SET" "$AGENT_RENDERS")" || AG_RC=$?
  else
    AOUT="$(AGENTS_LIBRARY_MISSING="$agmiss" "$PY" .agents/lib/harness.py agents "$AGENT_SET" "$AGENT_RENDERS")" || AG_RC=$?
  fi
  if [ -n "$AOUT" ]; then printf '%s\n' "$AOUT"; fi
  case "$AG_RC" in 0|1|5) if [ -f "$AGENT_RENDERS" ]; then AGENTS_DONE=1; fi ;; esac
  if [ "$AGENTS_DONE" -eq 0 ]; then
    : > "$AGENT_RENDERS"
    warn "rendering library agents failed (see above)"
    if [ "$CHECK" -eq 1 ]; then AGENT_FAILED=1; fi
  elif [ "$CHECK" -eq 1 ]; then
    case "$AOUT" in *"sync: out of date: "*) DRIFT=1 ;; esac
    if [ "$AG_RC" -eq 5 ]; then AGENT_FINDINGS=1; fi
  else
    if [ -n "$AOUT" ]; then CHANGED=1; fi
    if [ "$AG_RC" -eq 5 ]; then warn "some library agents weren't rendered (see the errors above)"; fi
  fi
  # Copy renders' hashes (skill_copies in generated.lock): 0 ok, 1 out of date (--check).
  if [ "$CHECK" -eq 1 ]; then
    "$PY" .agents/lib/harness.py skill-copies --check "$COPY_ROWS" || DRIFT=1
  else
    COUT="$("$PY" .agents/lib/harness.py skill-copies "$COPY_ROWS")" || warn "recording skill copy hashes failed (see above)"
    if [ -n "$COUT" ]; then printf '%s\n' "$COUT"; CHANGED=1; fi
  fi
else
  warn "python3 not found: hooks, permission rules, and library agents were not rendered. Install python3 and re-run."
  # With agents to render, --check can't say they're current.
  if [ "$CHECK" -eq 1 ] && [ -s "$AGENT_SET" ]; then AGENT_FAILED=1; fi
fi

# Local mode: keep everything the harness created out of git in this clone; team mode: only the
# personal skills and agents it renders. A marked block in the clone's exclude file lists exact
# paths; lines outside the markers belong to someone else. verify reads these same markers (local
# mode) to flag files tracked by accident; keep them in sync.
exclude_block() {
  local ex p pre
  ex="$(git rev-parse --git-path info/exclude 2>/dev/null)" || return 0
  [ -n "$ex" ] || return 0
  # Patterns there are relative to the repo top, so an install in a subdirectory prefixes them.
  pre="$(git rev-parse --show-prefix 2>/dev/null | sed 's/[[*?\\]/\\&/g' || true)"
  # Team mode with no block and no personal skills or agents: nothing of ours, so the file isn't
  # rewritten.
  if [ "$LOCAL" -eq 0 ] && [ ! -s "$PERSONAL_LIST" ] && [ ! -s "$COMMANDS_PERSONAL" ] && ! grep -q '^personal' "$AGENT_RENDERS" \
     && ! { [ -f "$ex" ] && grep -qxF "$EXCL_BEGIN" "$ex"; }; then return 0; fi
  : > "$WORK/exclude.list"
  # Agents didn't render (no python3, or it failed): keep the block's agent entries as they are,
  # so a personal render isn't left for git add -A and --check sees no false drift.
  # Not from a local block after a switch to team (a local block always has the whole-dir /.agents/
  # line, a team block never does): local mode hides shared renders that team mode commits.
  if [ "$AGENTS_DONE" -eq 0 ] && [ -f "$ex" ]; then
    AGENTS_EXCL_PRE="/$pre" awk -v b="$EXCL_BEGIN" -v e="$EXCL_END" -v nowlocal="$LOCAL" '$0 == b { f = 1; next } $0 == e { f = 0 }
      f { p = ENVIRON["AGENTS_EXCL_PRE"]; if (index($0, p) != 1) next
          r = substr($0, length(p) + 1)
          if (r == ".agents/") waslocal = 1
          else if (r ~ /^\.(claude|github|cursor|codex|gemini)\/agents\//) keep[++n] = $0 }
      END { if (!(waslocal == 1 && nowlocal != 1)) for (i = 1; i <= n; i++) print keep[i] }' "$ex" >> "$WORK/exclude.list"
  fi
  if [ "$LOCAL" -eq 0 ]; then
    # Team mode: the block holds only the personal skills this clone renders, their mirrors, its
    # personal agent renders, and the commands only a personal pack ships.
    while IFS= read -r p; do
      if rendered "$SKILLS_DIR/$p"; then echo "/$pre$SKILLS_DIR/$p" >> "$WORK/exclude.list"; fi
      if owned ".claude/skills/$p"; then echo "/$pre.claude/skills/$p" >> "$WORK/exclude.list"; fi
    done < "$PERSONAL_LIST"
    awk -F '\t' '$1 == "personal" { print $2 }' "$AGENT_RENDERS" | while IFS= read -r p; do
      echo "/$pre$p" >> "$WORK/exclude.list"
    done
    while IFS= read -r p; do
      if [ -f "$CMD_DIR/$p" ]; then echo "/$pre$CMD_DIR/$p" >> "$WORK/exclude.list"; fi
    done < "$COMMANDS_PERSONAL"
  fi
  if [ "$LOCAL" -eq 1 ]; then
    echo "/${pre}.agents/" >> "$WORK/exclude.list"
    for p in AGENTS.md CLAUDE.md CLAUDE.local.md .claude/settings.local.json .github/hooks/harness.json \
             .cursor/hooks.json .gemini/settings.json .codex/rules/harness.rules; do
      { [ -e "$p" ] || [ -L "$p" ]; } || continue
      tracked "$p" || echo "/$pre$p" >> "$WORK/exclude.list"
    done
    for p in .claude/skills/*; do
      { [ -e "$p" ] || [ -L "$p" ]; } || continue
      if owned "$p" && ! tracked "$p"; then echo "/$pre$p" >> "$WORK/exclude.list"; fi
    done
    cut -f2 "$AGENT_RENDERS" | while IFS= read -r p; do
      if [ -n "$p" ] && { [ -e "$p" ] || [ -L "$p" ]; } && ! tracked "$p"; then echo "/$pre$p" >> "$WORK/exclude.list"; fi
    done
  fi
  {
    if [ -f "$ex" ]; then
      awk -v b="$EXCL_BEGIN" -v e="$EXCL_END" '$0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip' "$ex"
    fi
    if [ -s "$WORK/exclude.list" ]; then echo "$EXCL_BEGIN"; cat "$WORK/exclude.list"; echo "$EXCL_END"; fi
  } > "$WORK/exclude.new"
  if [ -f "$ex" ] && cmp -s "$ex" "$WORK/exclude.new"; then return 0; fi
  if [ ! -f "$ex" ] && [ ! -s "$WORK/exclude.new" ]; then return 0; fi
  if [ "$CHECK" -eq 1 ]; then drift "$ex (harness block)"; return 0; fi
  mkdir -p "$(dirname "$ex")"
  cat "$WORK/exclude.new" > "$ex"
  CHANGED=1
  say "updated the harness block in $ex"
}
exclude_block

# Local mode: back up the local files where git clean, git stash -a, and checkouts can't reach.
# Team mode keeps none: a stale one could flip a later restore back to local. The one exception
# is AGENTS.md.before-tracked, the only copy of an old local AGENTS.md: that stays, with a warning.
if [ "$CHECK" -eq 0 ] && [ -f .agents/lib/feedback.sh ]; then
  export AGENTS_ROOT="$ROOT"   # read by feedback.sh
  # shellcheck source=/dev/null
  . .agents/lib/feedback.sh
  if [ "$LOCAL" -eq 1 ]; then
    agents_backup
  elif bk="$(agents_backup_dir)"; then
    rm -rf "$bk".new.* "$bk".old.* 2>/dev/null || true
    if [ -f "$bk/AGENTS.md.before-tracked" ]; then
      if [ -e "$bk/.agents" ]; then
        find "$bk" -mindepth 1 -maxdepth 1 ! -name AGENTS.md.before-tracked -exec rm -rf {} + 2>/dev/null || true
        echo "sync: warning: team mode keeps no backup, except your last local AGENTS.md in $bk/AGENTS.md.before-tracked; move its facts into AGENTS.md, then delete it" >&2
      fi
    elif [ -e "$bk" ]; then
      rm -rf "$bk" 2>/dev/null || true
    fi
  fi
fi

# Local git hooks appear once git.conf has something for them to enforce. Through bash, not exec'd:
# install.sh just copied it, and macOS assesses a new executable on its first exec (seconds).
if [ "$CHECK" -eq 0 ] && [ -x .agents/bin/gitflow ]; then
  bash .agents/bin/gitflow install-hooks --quiet | sed 's/^gitflow: /sync: /' || true
fi

# ---------------------------------------------------------------------------
# 3. Integrity: invisible Unicode in anything an agent reads as instructions
# ---------------------------------------------------------------------------
# zero-width chars, bidi controls, invisible operators, BOM, and Unicode tag characters
printf '\342\200\213\n\342\200\214\n\342\200\215\n\342\200\216\n\342\200\217\n\342\200\252\n\342\200\253\n\342\200\254\n\342\200\255\n\342\200\256\n\342\201\240\n\342\201\241\n\342\201\242\n\342\201\243\n\342\201\244\n\342\201\246\n\342\201\247\n\342\201\250\n\342\201\251\n\357\273\277\n\363\240\200\n\363\240\201\n' > "$WORK/hidden.pat"
{
  for f in AGENTS.md CLAUDE.md CLAUDE.local.md GEMINI.md .github/copilot-instructions.md; do if [ -f "$f" ]; then echo "$f"; fi; done
  find .agents .claude .cursor .github/hooks .github/agents .codex .gemini -type f \
    \( -name '*.md' -o -name '*.conf' -o -name '*.json' -o -name '*.sh' -o -name '*.py' -o -name '*.rules' -o -name '*.toml' -o -name '*.patterns' -o -name '*.allow' \) \
    -not -path '.agents/cache/*' -not -path '.agents/plans/*' -not -path '.agents/evals/results/*' 2>/dev/null || true
  # Skills and active packs are instructions too, wherever their library is: outside the project
  # (personal, listed), in it but outside .agents/, or a link the find above doesn't follow.
  { cut -f2 "$SKILL_SET"
    cut -f2 "$AGENT_SET"
    set -f
    for w in ${WORKFLOWS:-}; do agents_resolve workflows "$w" 2>/dev/null || true; done
    for s in ${STACKS:-}; do agents_resolve stacks "$s" 2>/dev/null || true; done
    set +f
  } | while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in "$ROOT"/*) p="${p#"$ROOT"/}" ;; esac
    find -H "$p" -type f \( -name '*.md' -o -name '*.conf' -o -name '*.json' -o -name '*.sh' -o -name '*.py' -o -name '*.snippet' \) 2>/dev/null || true
  done
} | LC_ALL=C sort -u > "$WORK/scan.list"
HIDDEN="$(tr '\n' '\0' < "$WORK/scan.list" | xargs -0 grep -lF -f "$WORK/hidden.pat" 2>/dev/null || true)"
if [ -n "$HIDDEN" ]; then
  while IFS= read -r f; do   # a heredoc, not a pipe: DRIFT must survive the loop
    if [ "$CHECK" -eq 1 ]; then
      say "invisible Unicode in $f (zero-width, bidi, or tag characters can hide instructions)"
      DRIFT=1
    else
      warn "invisible Unicode in $f (zero-width, bidi, or tag characters can hide instructions). Inspect it."
    fi
  done <<EOF
$HIDDEN
EOF
fi

# ---------------------------------------------------------------------------
# 4. Report
# ---------------------------------------------------------------------------
todos=$(cat "$AGENTS_FILE" .agents/checks/*.sh 2>/dev/null | grep -c 'TODO(harness-tailor)' || true)
[ "${todos:-0}" -eq 0 ] \
  || warn "$todos TODO(harness-tailor) markers left. Ask your agent to run the harness-tailor skill."

if [ "$CHECK" -eq 1 ]; then
  if [ "$DRIFT" -eq 0 ] && [ "$INFRA" -eq 0 ] && [ "$AGENT_FINDINGS" -eq 0 ] && [ "$AGENT_FAILED" -eq 0 ]; then
    say "up to date"; exit 0
  fi
  [ "$INFRA" -eq 0 ] || say "check out the libraries LIBRARIES lists (git submodule update --init, say), then re-run"
  [ "$AGENT_FINDINGS" -eq 0 ] || say "fix the agent files named above, then re-run"
  [ "$AGENT_FAILED" -eq 0 ] || say "fix the error above (or install python3), then re-run"
  [ "$DRIFT" -eq 0 ] || say "run .agents/bin/sync to fix"
  exit 1
fi
[ "$CHANGED" -eq 1 ] || say "already up to date"
