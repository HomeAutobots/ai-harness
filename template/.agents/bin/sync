#!/usr/bin/env bash
# ai-harness: sync
# Harness-owned. Replaced on upgrade, so don't customize it in a project.
#
# Renders the managed blocks in AGENTS.md and maintains tool adapters (instructions, skills,
# hooks, permissions). Also the CI gate for harness integrity.
#   .agents/bin/sync                                   apply
#   .agents/bin/sync --check                           change nothing; exit 1 if anything is out
#                                                      of date, a pinned skill changed, or an
#                                                      instruction file hides invisible Unicode
#   .agents/bin/sync --lock-skill <name> <source> <ref>   pin a third-party skill by content hash
#   .agents/bin/sync --unshare                         (install.sh --local) strip the harness from
#                                                      tracked shared files, list what to untrack
#
# bash 3.2+ and POSIX tools; python3 renders the JSON configs (hooks, permissions).
set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

PY="$(command -v python3 || true)"
CHECK=0
UNSHARE=0
case "${1:-}" in
  --check) CHECK=1 ;;
  --unshare) UNSHARE=1 ;;
  --lock-skill)
    [ $# -eq 4 ] || { echo "usage: $0 --lock-skill <name> <source> <ref>" >&2; exit 2; }
    [ -n "$PY" ] || { echo "sync: python3 is required to pin skills" >&2; exit 2; }
    exec "$PY" .agents/lib/harness.py lock-skill "$2" "$3" "$4" ;;
  "") ;;
  *) echo "usage: $0 [--check | --unshare | --lock-skill <name> <source> <ref>]" >&2; exit 2 ;;
esac

AGENTS_FILE=AGENTS.md
CORE_SRC=.agents/core/AGENTS.core.md
SKILLS_DIR=.agents/skills

# Defaults. harness.conf overrides them.
ADAPTERS="claude copilot cursor"
LINK_MODE="symlink"
HARNESS_MODE="team"
# shellcheck source=/dev/null
[ -f .agents/harness.conf ] && . ./.agents/harness.conf

DRIFT=0
CHANGED=0
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

say()   { printf 'sync: %s\n' "$*"; }
warn()  { printf 'sync: warning: %s\n' "$*" >&2; }
die()   { printf 'sync: error: %s\n' "$*" >&2; exit 2; }
drift() { say "out of date: $*"; DRIFT=1; }

tracked() { git ls-files --error-unmatch -- "$1" >/dev/null 2>&1; }
# claude_stub <file>: true if the file holds only what the harness writes (imports, blank lines,
# the marker comment), so regenerating it loses nothing.
CLAUDE_MARK='<!-- Shared instructions live in AGENTS.md'
claude_stub() {
  [ -z "$(grep -vE "^@[^[:space:]]+[[:space:]]*\$|^[[:space:]]*\$|^$CLAUDE_MARK" "$1")" ]
}
LOCAL=0; [ "$HARNESS_MODE" = local ] && LOCAL=1

# --unshare (install.sh --local on a team install): take the harness out of tracked shared files.
# Prints "untrack <path>" for files that are only harness boilerplate; strips the rest in place.
# Runs before the local-mode redirect below: install untracks first, then a plain sync settles.
if [ "$UNSHARE" -eq 1 ]; then
  if tracked AGENTS.md && [ -f AGENTS.md ]; then
    if grep -q '^> \*\*Not tailored yet\.\*\*' AGENTS.md; then
      echo "untrack AGENTS.md"
    else
      # Drop the blocks and the blank lines render_block put around them (held: blank lines seen).
      awk '/<!-- harness:(core|skills):start -->/ { skip = 1; gap = (held != ""); tail = 1; next }
           /<!-- harness:(core|skills):end -->/ { skip = 0; next }
           skip { next }
           /^[ \t\r]*$/ { if (!gap) held = held $0 "\n"; next }
           { printf "%s", held; held = ""; gap = 0; tail = 0; print }
           END { if (!tail) printf "%s", held }' AGENTS.md > "$WORK/agents.md"
      cmp -s AGENTS.md "$WORK/agents.md" || { cat "$WORK/agents.md" > AGENTS.md; echo "stripped AGENTS.md"; }
    fi
  fi
  # CLAUDE.md: only the harness's lines go (its imports and the marker line it writes), and only
  # when the marker says the harness wrote the file. A project's own CLAUDE.md stays as it is.
  if tracked CLAUDE.md && [ -f CLAUDE.md ] && grep -q "^$CLAUDE_MARK" CLAUDE.md; then
    awk -v m="$CLAUDE_MARK" '/^@(AGENTS\.md|\.agents\/AGENTS\.local\.md)[ \t\r]*$/ { next }
         index($0, m) == 1 { held = ""; next }
         /^[ \t\r]*$/ { held = held $0 "\n"; next }
         { printf "%s", held; held = ""; print }
         END { printf "%s", held }' CLAUDE.md > "$WORK/claude.md"
    if ! grep -q '[^[:space:]]' "$WORK/claude.md"; then
      echo "untrack CLAUDE.md"
    elif ! cmp -s CLAUDE.md "$WORK/claude.md"; then
      cat "$WORK/claude.md" > CLAUDE.md; echo "stripped CLAUDE.md"
    fi
  fi
  if [ -n "$PY" ]; then "$PY" .agents/lib/harness.py unshare; fi
  exit 0
fi

# Local mode never modifies a file the project tracks. With a tracked AGENTS.md, the managed
# blocks live in an untracked file of their own, imported by the Claude instructions file.
if [ "$LOCAL" -eq 1 ] && tracked AGENTS.md; then
  AGENTS_FILE=.agents/AGENTS.local.md
  if [ ! -f "$AGENTS_FILE" ] && [ "$CHECK" -eq 0 ]; then
    printf '%s\n' '# Harness instructions (local)' '' \
      'This clone runs the AI harness in local mode and the project tracks AGENTS.md, so the harness keeps its instructions here. Project facts from harness-tailor go below the blocks.' \
      > "$AGENTS_FILE"
  fi
  case " $ADAPTERS " in *" copilot "*|*" cursor "*|*" codex "*)
    [ "$CHECK" -eq 1 ] || warn "the project tracks AGENTS.md, so Copilot, Cursor, and Codex (which read only AGENTS.md) won't see the harness rules in this clone; their hooks still enforce the checks and policy" ;;
  esac
fi

[ -f "$AGENTS_FILE" ] || die "no $AGENTS_FILE at repo root. Run install.sh from the ai-harness repo first."
[ -f "$CORE_SRC" ]    || die "missing $CORE_SRC. Re-run install.sh."

# put <target> <generated>: write target only when content differs
put() {
  if [ -f "$1" ] && cmp -s "$1" "$2"; then return 0; fi
  if [ "$CHECK" -eq 1 ]; then drift "$1"; return 0; fi
  mkdir -p "$(dirname "$1")"
  cat "$2" > "$1"
  CHANGED=1
  say "wrote $1"
}

# render_block <name> <body> <in> <out>
# Replaces everything between the block's markers with body. If the markers are
# missing, inserts the block: core goes right after the H1, anything else at the end.
render_block() {
  local name="$1" body="$2" in="$3" out="$4"
  local start="<!-- harness:${name}:start -->" end="<!-- harness:${name}:end -->"
  local ns ne
  ns=$(grep -cF "$start" "$in" || true)
  ne=$(grep -cF "$end" "$in" || true)

  if [ "$ns" -eq 0 ] && [ "$ne" -eq 0 ]; then
    awk -v s="$start" -v e="$end" -v bf="$body" -v mode="$name" '
      function emit(  line) {
        print ""; print s
        while ((getline line < bf) > 0) print line
        close(bf); print e; done = 1
      }
      { print }
      mode == "core" && !done && /^# / { emit(); print "" }
      END { if (!done) emit() }
    ' "$in" > "$out"
    return 0
  fi

  { [ "$ns" -eq 1 ] && [ "$ne" -eq 1 ]; } \
    || die "$AGENTS_FILE needs exactly one '$start' and one '$end'"

  awk -v s="$start" -v e="$end" -v bf="$body" '
    { t = $0; gsub(/^[ \t]+|[ \t\r]+$/, "", t) }
    t == s { print s; while ((getline line < bf) > 0) print line; close(bf); skip = 1; next }
    t == e { skip = 0; print e; next }
    !skip  { print }
  ' "$in" > "$out"
}

# skill_meta <SKILL.md>: prints "name<TAB>description" from YAML frontmatter.
# Handles plain, quoted, and folded (> or |) descriptions.
skill_meta() {
  awk -v q="'" '
    { sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; fm = 1; next }
    fm && $0 == "---" { exit }
    fm {
      if (folding) {
        if ($0 ~ /^[ \t]+[^ \t]/) { v = $0; sub(/^[ \t]+/, "", v); desc = desc (desc == "" ? "" : " ") v; next }
        folding = 0
      }
      if ($0 ~ /^name:/) { name = $0; sub(/^name:[ \t]*/, "", name) }
      else if ($0 ~ /^description:/) {
        desc = $0; sub(/^description:[ \t]*/, "", desc)
        if (desc == "" || desc ~ /^[>|][-+]?$/) { desc = ""; folding = 1 }
      }
    }
    function unquote(v) {
      if (v ~ /^".*"$/ || v ~ ("^" q ".*" q "$")) return substr(v, 2, length(v) - 2)
      return v
    }
    END { printf "%s\t%s\n", unquote(name), unquote(desc) }
  ' "$1"
}

# ---------------------------------------------------------------------------
# 1. AGENTS.md managed blocks
# ---------------------------------------------------------------------------
CORE_BODY="$WORK/core.md"
{
  printf '<!-- Managed by ai-harness via .agents/bin/sync. Edits inside this block get overwritten. -->\n\n'
  cat "$CORE_SRC"
} > "$CORE_BODY"

SKILLS_BODY="$WORK/skills.md"
{
  echo "## Skills index"
  echo "Generated from \`.agents/skills/*/SKILL.md\` by \`.agents/bin/sync\`. If your tool doesn't load skills on its own, read the matching SKILL.md before starting that kind of task."
  echo
  found=0
  for dir in "$SKILLS_DIR"/*/; do
    f="${dir}SKILL.md"
    [ -f "$f" ] || continue
    dname="$(basename "$dir")"
    meta="$(skill_meta "$f")"
    sname="${meta%%$'\t'*}"
    sdesc="${meta#*$'\t'}"
    [ -n "$sname" ] || warn "$f has no 'name' in its frontmatter"
    [ -z "$sname" ] || [ "$sname" = "$dname" ] \
      || warn "$f: name '$sname' doesn't match folder '$dname' (the Agent Skills spec requires a match)"
    [ -n "$sdesc" ] || warn "$f has no 'description', so agents won't know when to use it"
    echo "- \`$dname\`: $sdesc"
    found=1
  done
  [ "$found" -eq 1 ] || echo "_No skills yet._"
} > "$SKILLS_BODY"

# Local mode hides an untracked AGENTS.md from git. One that was already here before the harness
# (no harness blocks yet) is someone's own file, so say so once, as the blocks go in.
if [ "$LOCAL" -eq 1 ] && [ "$CHECK" -eq 0 ] && [ "$AGENTS_FILE" = AGENTS.md ] \
   && ! grep -qF '<!-- harness:core:start -->' AGENTS.md; then
  warn "AGENTS.md was here before the harness and git doesn't track it, so local mode now hides it from git status too. To share it, take the harness blocks out, commit it, and re-run sync."
fi
render_block core   "$CORE_BODY"   "$AGENTS_FILE" "$WORK/step1.md"
render_block skills "$SKILLS_BODY" "$WORK/step1.md" "$WORK/step2.md"
put "$AGENTS_FILE" "$WORK/step2.md"

# ---------------------------------------------------------------------------
# 2. Adapters
# ---------------------------------------------------------------------------

# owned <path>: true if the harness created it (our symlink or a marked copy)
owned() {
  if [ -L "$1" ]; then
    case "$(readlink "$1")" in "../../$SKILLS_DIR/"*) return 0 ;; esac
    return 1
  fi
  [ -f "$1/.harness-copy" ]
}

# mirror_skills <tool-skills-dir>: expose each .agents/skills/<name> in a tool's own skills dir
mirror_skills() {
  local dest="$1" dir src name target rel
  for dir in "$SKILLS_DIR"/*/; do
    [ -f "${dir}SKILL.md" ] || continue
    src="${dir%/}"
    name="$(basename "$src")"
    target="$dest/$name"
    rel="../../$SKILLS_DIR/$name"

    if [ "$LOCAL" -eq 1 ] && tracked "$target"; then
      warn "$target is tracked by the project; local mode leaves it alone"
      continue
    fi

    if { [ -e "$target" ] || [ -L "$target" ]; } && ! owned "$target"; then
      warn "$target already exists and wasn't made by the harness, leaving it alone"
      continue
    fi

    if [ "$LINK_MODE" = copy ]; then
      if [ ! -L "$target" ] && [ -d "$target" ] \
         && diff -rq -x .harness-copy "$src" "$target" >/dev/null 2>&1; then continue; fi
    else
      if [ -L "$target" ] && [ "$(readlink "$target")" = "$rel" ]; then continue; fi
    fi

    if [ "$CHECK" -eq 1 ]; then drift "$target"; continue; fi
    mkdir -p "$dest"
    rm -rf "$target"
    if [ "$LINK_MODE" = copy ]; then
      cp -R "$src" "$target"
      : > "$target/.harness-copy"
    else
      ln -s "$rel" "$target"
    fi
    CHANGED=1
    say "mirrored $target ($LINK_MODE)"
  done

  # Remove harness-made entries whose skill no longer exists.
  [ -d "$dest" ] || return 0
  for target in "$dest"/*; do
    { [ -e "$target" ] || [ -L "$target" ]; } || continue
    name="$(basename "$target")"
    [ -f "$SKILLS_DIR/$name/SKILL.md" ] && continue
    owned "$target" || continue
    [ "$LOCAL" -eq 1 ] && tracked "$target" && continue
    if [ "$CHECK" -eq 1 ]; then drift "$target (stale)"; continue; fi
    rm -rf "$target"
    CHANGED=1
    say "removed stale $target"
  done
}

adapter_claude() {
  # An @import works on every Claude Code setup. The built-in AGENTS.md fallback only kicks in
  # with no CLAUDE.md present (any CLAUDE*.md counts) and isn't available on every provider.
  local cf=CLAUDE.md imports="@AGENTS.md"
  if [ "$LOCAL" -eq 1 ]; then
    if tracked CLAUDE.md; then
      cf=CLAUDE.local.md
      grep -qE '^@AGENTS\.md[[:space:]]*$' CLAUDE.md && imports=""
    fi
    [ "$AGENTS_FILE" = AGENTS.md ] || imports="${imports:+$imports }@$AGENTS_FILE"
  fi
  if [ "$LOCAL" -eq 1 ] && [ "$cf" != CLAUDE.md ] && tracked "$cf"; then
    warn "$cf is tracked by the project; local mode leaves it alone"
    imports=""
  fi
  # Nothing to import (the tracked CLAUDE.md already imports AGENTS.md, which holds the blocks):
  # no personal file needed.
  if [ -n "$imports" ]; then
    # A stub keeps imports someone added (existing order first); the harness's own two imports
    # stay only while they're wanted.
    : > "$WORK/claude.md"
    if [ -f "$cf" ] && claude_stub "$cf"; then
      sed -n 's/^\(@[^[:space:]]*\)[[:space:]]*$/\1/p' "$cf" | while IFS= read -r i; do
        case "$i" in @AGENTS.md|@.agents/AGENTS.local.md) case " $imports " in *" $i "*) ;; *) continue ;; esac ;; esac
        grep -qxF -- "$i" "$WORK/claude.md" || printf '%s\n' "$i" >> "$WORK/claude.md"
      done
    fi
    for i in $imports; do grep -qxF -- "$i" "$WORK/claude.md" || printf '%s\n' "$i" >> "$WORK/claude.md"; done
    printf '%s\n' '' "$CLAUDE_MARK. Claude Code-only notes go below this line. -->" >> "$WORK/claude.md"
    if [ ! -f "$cf" ] || claude_stub "$cf"; then
      put "$cf" "$WORK/claude.md"
    else
      for i in $imports; do
        grep -qxF "$i" "$cf" \
          || warn "$cf doesn't import ${i#@}, so Claude Code won't see the harness. Run the harness-tailor skill to fold it in, or add '$i' as a line."
      done
    fi
  fi
  # Team mode: a CLAUDE.local.md the harness made (marker line included) would load AGENTS.md twice.
  if [ "$LOCAL" -eq 0 ] && [ -f CLAUDE.local.md ] && claude_stub CLAUDE.local.md \
     && grep -q "^$CLAUDE_MARK" CLAUDE.local.md; then
    if [ "$CHECK" -eq 1 ]; then drift "CLAUDE.local.md (remove)"; else rm -f CLAUDE.local.md; CHANGED=1; say "removed CLAUDE.local.md (team mode uses CLAUDE.md)"; fi
  fi
  mirror_skills .claude/skills
}

for a in $ADAPTERS; do
  case "$a" in
    claude) adapter_claude ;;
    copilot|cursor|codex|gemini) ;;  # rendered by harness.py below
    *) warn "unknown adapter '$a' in .agents/harness.conf" ;;
  esac
done

# JSON configs: hooks, permission rules, Codex execpolicy, Gemini context. Merged into files the
# project may already own; only entries the harness added are replaced.
if [ -n "$PY" ]; then
  RENDER_RC=0
  if [ "$CHECK" -eq 1 ]; then
    "$PY" .agents/lib/harness.py render --check || RENDER_RC=$?
    [ "$RENDER_RC" -eq 0 ] || DRIFT=1
  else
    OUT="$("$PY" .agents/lib/harness.py render)" || RENDER_RC=$?
    [ -n "$OUT" ] && { printf '%s\n' "$OUT"; CHANGED=1; }
    [ "$RENDER_RC" -eq 0 ] || warn "adapter rendering reported errors (see above)"
  fi
  "$PY" .agents/lib/harness.py check-skills || DRIFT=1
else
  warn "python3 not found: hooks and permission rules were not rendered. Install python3 and re-run."
fi

# Local mode: keep everything the harness created out of git in this clone. A marked block in
# the clone's exclude file lists exact paths; lines outside the markers belong to someone else.
# verify reads these same markers to flag files tracked by accident; keep them in sync.
EXCL_BEGIN="# >>> ai-harness (local install; managed by .agents/bin/sync)"
EXCL_END="# <<< ai-harness"
exclude_block() {
  local ex p pre
  ex="$(git rev-parse --git-path info/exclude 2>/dev/null)" || return 0
  [ -n "$ex" ] || return 0
  # Patterns there are relative to the repo top, so an install in a subdirectory prefixes them.
  pre="$(git rev-parse --show-prefix 2>/dev/null || true)"
  # Team mode with no block: nothing of ours to remove, so the file isn't even rewritten.
  if [ "$LOCAL" -eq 0 ] && ! { [ -f "$ex" ] && grep -qxF "$EXCL_BEGIN" "$ex"; }; then return 0; fi
  : > "$WORK/exclude.list"
  if [ "$LOCAL" -eq 1 ]; then
    echo "/${pre}.agents/" >> "$WORK/exclude.list"
    for p in AGENTS.md CLAUDE.md CLAUDE.local.md .claude/settings.local.json .github/hooks/harness.json \
             .cursor/hooks.json .gemini/settings.json .codex/rules/harness.rules; do
      { [ -e "$p" ] || [ -L "$p" ]; } || continue
      tracked "$p" || echo "/$pre$p" >> "$WORK/exclude.list"
    done
    for p in .claude/skills/*; do
      { [ -e "$p" ] || [ -L "$p" ]; } || continue
      if owned "$p" && ! tracked "$p"; then echo "/$pre$p" >> "$WORK/exclude.list"; fi
    done
  fi
  {
    if [ -f "$ex" ]; then
      awk -v b="$EXCL_BEGIN" -v e="$EXCL_END" '$0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip' "$ex"
    fi
    if [ -s "$WORK/exclude.list" ]; then echo "$EXCL_BEGIN"; cat "$WORK/exclude.list"; echo "$EXCL_END"; fi
  } > "$WORK/exclude.new"
  if [ -f "$ex" ] && cmp -s "$ex" "$WORK/exclude.new"; then return 0; fi
  if [ ! -f "$ex" ] && [ ! -s "$WORK/exclude.new" ]; then return 0; fi
  if [ "$CHECK" -eq 1 ]; then drift "$ex (harness block)"; return 0; fi
  mkdir -p "$(dirname "$ex")"
  cat "$WORK/exclude.new" > "$ex"
  CHANGED=1
  say "updated the harness block in $ex"
}
exclude_block

# Local git hooks appear once git.conf has something for them to enforce.
if [ "$CHECK" -eq 0 ] && [ -x .agents/bin/gitflow ]; then
  .agents/bin/gitflow install-hooks --quiet | sed 's/^gitflow: /sync: /' || true
fi

# ---------------------------------------------------------------------------
# 3. Integrity: invisible Unicode in anything an agent reads as instructions
# ---------------------------------------------------------------------------
# zero-width chars, bidi controls, invisible operators, BOM, and Unicode tag characters
printf '\342\200\213\n\342\200\214\n\342\200\215\n\342\200\216\n\342\200\217\n\342\200\252\n\342\200\253\n\342\200\254\n\342\200\255\n\342\200\256\n\342\201\240\n\342\201\241\n\342\201\242\n\342\201\243\n\342\201\244\n\342\201\246\n\342\201\247\n\342\201\250\n\342\201\251\n\357\273\277\n\363\240\200\n\363\240\201\n' > "$WORK/hidden.pat"
{
  for f in AGENTS.md CLAUDE.md CLAUDE.local.md GEMINI.md .github/copilot-instructions.md; do if [ -f "$f" ]; then echo "$f"; fi; done
  find .agents .claude .cursor .github/hooks .github/agents .codex .gemini -type f \
    \( -name '*.md' -o -name '*.conf' -o -name '*.json' -o -name '*.sh' -o -name '*.py' -o -name '*.rules' -o -name '*.toml' -o -name '*.patterns' -o -name '*.allow' \) \
    -not -path '.agents/cache/*' -not -path '.agents/plans/*' -not -path '.agents/evals/results/*' 2>/dev/null || true
} > "$WORK/scan.list"
HIDDEN="$(tr '\n' '\0' < "$WORK/scan.list" | xargs -0 grep -lF -f "$WORK/hidden.pat" 2>/dev/null || true)"
if [ -n "$HIDDEN" ]; then
  for f in $HIDDEN; do
    if [ "$CHECK" -eq 1 ]; then
      say "invisible Unicode in $f (zero-width, bidi, or tag characters can hide instructions)"
      DRIFT=1
    else
      warn "invisible Unicode in $f (zero-width, bidi, or tag characters can hide instructions). Inspect it."
    fi
  done
fi

# ---------------------------------------------------------------------------
# 4. Report
# ---------------------------------------------------------------------------
todos=$(cat "$AGENTS_FILE" .agents/checks/*.sh 2>/dev/null | grep -c 'TODO(harness-tailor)' || true)
[ "${todos:-0}" -eq 0 ] \
  || warn "$todos TODO(harness-tailor) markers left. Ask your agent to run the harness-tailor skill."

if [ "$CHECK" -eq 1 ]; then
  if [ "$DRIFT" -eq 0 ]; then say "up to date"; exit 0; fi
  say "run .agents/bin/sync to fix"
  exit 1
fi
[ "$CHANGED" -eq 1 ] || say "already up to date"
