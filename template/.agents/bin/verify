#!/usr/bin/env bash
# ai-harness: verify (orchestrator). Harness-owned: replaced on upgrade.
#
#   .agents/bin/verify [--tier=edit|turn|full] [--json] [--no-cache] [--update-baseline] [--since=<rev>] [files...]
#
# Runs the guard, the project's checks for a tier (.agents/checks/<tier>.sh, project-owned), and
# each active workflow pack's checks (<library>/workflows/<name>/checks/<tier>.sh, run in place), then shapes the result: one line when green, capped findings when not, full log on disk. A pack's "note: " lines show under the status line either way.
#   edit  per-file checks on the given files (the post-edit hook, or `check <files>`)
#   turn  the default; what the stop hook runs: build, affected tests, lint on changed code
#   full  commit gate and CI: everything, including slow checks
# --since=<rev> (repeatable): checks also get AGENTS_SINCE (those commits), so a check that reads it
# judges what was committed since then too (the stop gate passes HEAD and the branch tips its turn
# started from). The feature-driven pack reads it; the file list the checks get is the same as without it.
# Results are cached by working-tree state, so repeat calls with no changes are instant.
# Exit: 0 ok/skipped, 1 findings, 2 policy block, 3 tooling problem, 124 out of budget.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
export AGENTS_ROOT="$ROOT"
# shellcheck source=../lib/feedback.sh
. "$ROOT/.agents/lib/feedback.sh"
# shellcheck source=../lib/rules_copies.sh
[ -f "$ROOT/.agents/lib/rules_copies.sh" ] && . "$ROOT/.agents/lib/rules_copies.sh"
agents_load_conf
cd "$ROOT" || exit 3
agents_libraries_pin   # one scan of the library search path for this run and the checks it starts

TIER=turn JSON=0 CACHE=1 SINCE=""
FILES=()
while [ $# -gt 0 ]; do
  case "$1" in
    --tier=*) TIER="${1#--tier=}" ;;
    --json) JSON=1 ;;
    --no-cache) CACHE=0 ;;
    --update-baseline) export AGENTS_UPDATE_BASELINE=1; CACHE=0 ;;
    --since=*) SINCE="$SINCE ${1#--since=}" ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do FILES+=("$1"); shift; done; break ;;
    -*) echo "verify: unknown option $1" >&2; exit 3 ;;
    *) FILES+=("$1") ;;
  esac
  shift
done

case "$TIER" in
  edit) BUDGET="$EDIT_BUDGET" ;;
  turn) BUDGET="$TURN_BUDGET" ;;
  full) BUDGET="$FULL_BUDGET" ;;
  *) echo "verify: unknown tier '$TIER' (edit, turn, full)" >&2; exit 3 ;;
esac

# Only --since sets AGENTS_SINCE (the commits, space-separated), never a stray variable from the
# caller's environment.
AGENTS_SINCE=""
set -f
for s in $SINCE; do
  c="$(git rev-parse -q --verify "$s^{commit}" 2>/dev/null)" || { echo "verify: --since=$s isn't a commit" >&2; exit 3; }
  AGENTS_SINCE="${AGENTS_SINCE:+$AGENTS_SINCE }$c"
done
set +f
export AGENTS_SINCE

# Normalize explicit files to repo-relative paths that exist; default to the changed set.
if [ ${#FILES[@]} -gt 0 ]; then
  NORM=()
  PROOT="$(pwd -P)"   # the repo with symlinks resolved: an absolute path may use either spelling
  for f in "${FILES[@]}"; do
    case "$f" in
      "$ROOT"/*) f="${f#"$ROOT"/}" ;;
      ./*) f="${f#./}" ;;
      /*) d="$(cd "$(dirname "$f")" 2>/dev/null && pwd -P)" \
            && case "$d/" in "$PROOT"/*) f="${d#"$PROOT"}/${f##*/}"; f="${f#/}" ;; esac ;;
    esac
    [ -f "$f" ] && NORM+=("$f")
  done
  FILES=()
  [ ${#NORM[@]} -gt 0 ] && FILES=("${NORM[@]}")
elif [ "$TIER" != edit ]; then
  while IFS= read -r f; do [ -n "$f" ] && FILES+=("$f"); done < <(agents_changed_files)
fi

emit() {  # emit <status-word> <rc> <shaped-file> <log-path>; pack notes from $NOTES, if any
  local word="$1" rc="$2" shaped="$3" log="$4" notes="${NOTES:-}"
  [ -n "$notes" ] && [ -s "$notes" ] || notes=/dev/null
  if [ "$JSON" -eq 1 ]; then
    # "notes" only when there are some, so the shape is unchanged without them.
    nf="$notes" awk -v tier="$TIER" -v rc="$rc" -v word="$word" -v logp="$log" '
      function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\t/, "\\t", s); gsub(/[\001-\037]/, " ", s); return s }
      { a[++n] = "\"" esc($0) "\"" }
      END {
        printf "{\"tool\":\"verify\",\"tier\":\"%s\",\"status\":\"%s\",\"exit\":%d,\"findings\":[", tier, tolower(word), rc
        for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? "," : ""), a[i]
        printf "]"
        while ((getline l < ENVIRON["nf"]) > 0) if (!(l in seen)) { seen[l] = 1; nl = nl (nl == "" ? "" : ",") "\"" esc(l) "\"" }
        if (nl != "") printf ",\"notes\":[%s]", nl
        printf ",\"log\":\"%s\"}\n", esc(logp)
      }' "$shaped"
  else
    echo "$word verify $TIER"
    awk '!seen[$0]++' "$notes"
    if [ "$rc" -ne 0 ]; then
      cat "$shaped"
      [ -n "$log" ] && echo "full log: $log"
    fi
  fi
}

# Nothing to check for the edit tier without files.
if [ "$TIER" = edit ] && [ ${#FILES[@]} -eq 0 ]; then
  emit ok 0 /dev/null ""
  exit 0
fi

mkdir -p "$AGENTS_CACHE"
KEY=""
if [ "$CACHE" -eq 1 ]; then
  if [ ${#FILES[@]} -gt 0 ]; then KEY="$(agents_state_key "${FILES[@]}")"; else KEY="$(agents_state_key)"; fi
  KEY="$TIER-$JSON-$AGENTS_SINCE-$KEY"
  C="$AGENTS_CACHE/verify-$TIER-$JSON"
  if [ -f "$C.key" ] && [ "$(cat "$C.key")" = "$KEY" ]; then
    [ "$TIER" = edit ] || agents_backup quiet   # local mode: the key ignores .agents/, so refresh anyway
    cat "$C.out"
    exit "$(cat "$C.rc")"
  fi
fi

RAW="$(mktemp)"; SHAPED="$(mktemp)"; NOTES="$RAW.notes"
trap 'rm -f "$RAW" "$SHAPED" "$RAW.part" "$NOTES"' EXIT

# 1. Guard: new suppressions, skipped or deleted tests. Cheap, always first.
GUARD_RC=0
# Through bash when it's executable: macOS assesses a new executable on its first exec (seconds).
GUARD=("$ROOT/.agents/bin/guard"); [ -x "${GUARD[0]}" ] && GUARD=(bash "${GUARD[0]}")
if [ "$TIER" = edit ]; then
  "${GUARD[@]}" "${FILES[@]}" >"$RAW.part" 2>&1 || GUARD_RC=$?
else
  "${GUARD[@]}" >"$RAW.part" 2>&1 || GUARD_RC=$?
fi
[ "$GUARD_RC" -ne 0 ] && cat "$RAW.part" >> "$RAW"

# 1b. Local install mode: nothing the harness keeps out of git may be tracked.
# The paths come from this install's block in the exclude file (.agents/lib/exclude.sh, which sync
# writes it with). Block entries are relative to the repo top; an install in a subdirectory strips
# its prefix to get paths relative to here.
# A tracked file other than .agents/ counts only while it still holds harness content: a stale
# entry for a file the project has since committed on its own is sync's to drop, not a finding.
agent_marked() {  # agent_marked <line no> <file>: that line is sync's generated-by marker
  case "$(sed -n "$1p" "$2" 2>/dev/null)" in "# generated by .agents/bin/sync from "*) return 0 ;; esac
  return 1
}
harness_content() {  # harness_content <path>: true if the file (or skill mirror) is the harness's
  case "$1" in
    AGENTS.md) grep -qF '<!-- harness:core:start -->' "$1" 2>/dev/null ;;
    CLAUDE.md|CLAUDE.local.md) grep -q '^<!-- Shared instructions live in AGENTS.md' "$1" 2>/dev/null ;;
    .codex/rules/harness.rules) grep -qF 'Generated by ai-harness' "$1" 2>/dev/null ;;
    AGENTS.override.md|GEMINI.md|.cursor/rules/ai-harness.mdc|.github/instructions/ai-harness.instructions.md)
      agents_rules_marked "$1" ;;
    # MCP configs: sync's servers are the ones generated.lock records for the file; its codex block.
    .mcp.json|.cursor/mcp.json) grep -qF "\"$1\": [" .agents/generated.lock 2>/dev/null ;;
    # Gemini settings: sync's MCP servers, or the harness hooks.
    .gemini/settings.json) grep -qF "\"$1\": [" .agents/generated.lock 2>/dev/null || grep -qF '.agents/hooks/' "$1" 2>/dev/null ;;
    .codex/config.toml) grep -qxF '# >>> ai-harness mcp (managed by .agents/bin/sync)' "$1" 2>/dev/null ;;
    *.json) grep -qF '.agents/hooks/' "$1" 2>/dev/null ;;
    .claude/skills/*)
      if [ -L "$1" ]; then case "$(readlink "$1")" in ../../.agents/skills/*) return 0 ;; esac; return 1; fi
      [ -f "$1/.harness-copy" ] ;;
    # An agent render carries sync's marker: first line (TOML) or the line after --- (Markdown).
    .codex/agents/*) agent_marked 1 "$1" ;;
    .claude/agents/*|.github/agents/*|.cursor/agents/*|.gemini/agents/*) agent_marked 2 "$1" ;;
    *) return 0 ;;
  esac
}
LOCAL_RC=0
if [ "$TIER" != edit ] && [ "${HARNESS_MODE:-team}" = local ]; then
  paths=""
  if [ -f "$ROOT/.agents/lib/exclude.sh" ]; then
    # shellcheck source=../lib/exclude.sh
    . "$ROOT/.agents/lib/exclude.sh"
    ex="$(agents_excl_file)"; begin="$(agents_excl_begin)"
    # Same escaping as sync's entries; passed through the environment, since awk -v eats backslashes.
    pre="$(agents_excl_pre)"
    [ -f "$ex" ] && [ -n "$begin" ] && paths="$(agents_excl_own "$ex" "$begin" | pre="$pre" awk '
                               { sub(/^\//, ""); sub(/\/$/, ""); pre = ENVIRON["pre"]
                                 if (pre != "") { if (index($0, pre) != 1) next; $0 = substr($0, length(pre) + 1) }
                                 print }')"
  fi
  [ -n "$paths" ] || paths=".agents"
  hits=""
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    tf="$(git ls-files -- "$p" 2>/dev/null)"
    [ -n "$tf" ] || continue
    [ "$p" = .agents ] || harness_content "$p" || continue
    hits="$hits $p"
    printf '%s\n' "$tf" | while IFS= read -r f; do
      echo "$f:1: error: [harness-tracked] tracked in git, but this clone keeps the harness local (HARNESS_MODE=local)"
    done >> "$RAW"
  done <<EOF
$paths
EOF
  if [ -n "$hits" ]; then
    echo "  fix: if the team adopted the harness, run install.sh --team on this project; otherwise git rm -r --cached --quiet --$hits   (keeps the files; commit the removal)" >> "$RAW"
    LOCAL_RC=1
  fi
  # The instruction copies sync writes for tools that read only their own files. Codex's holds
  # AGENTS.md too, so a pull that changes AGENTS.md leaves it behind until the next sync.
  if [ -f .agents/AGENTS.local.md ] && git ls-files --error-unmatch -- AGENTS.md >/dev/null 2>&1; then
    stale=""
    for p in ${AGENTS_RULES_COPIES:-}; do
      agents_rules_marked "$p" || continue
      git ls-files --error-unmatch -- "$p" >/dev/null 2>&1 && continue
      agents_rules_copy "$p" .agents/AGENTS.local.md AGENTS.md > "$RAW.part"
      cmp -s "$RAW.part" "$p" && continue
      echo "$p:1: error: [harness-stale] $(agents_rules_tool "$p") reads this copy of the harness instructions, and $(agents_rules_stale_why "$p")" >> "$RAW"
      stale=1
    done
    if [ -n "$stale" ]; then
      echo "  fix: run .agents/bin/sync" >> "$RAW"
      LOCAL_RC=1
    fi
  fi
fi

# 2. The project's checks for this tier.
CHECK_RC=0
SCRIPT=".agents/checks/$TIER.sh"
if [ -f "$SCRIPT" ]; then
  export AGENTS_TIER="$TIER"
  if [ ${#FILES[@]} -gt 0 ]; then
    agents_budget_run "$BUDGET" "$RAW.part" bash "$SCRIPT" "${FILES[@]}" || CHECK_RC=$?
  else
    agents_budget_run "$BUDGET" "$RAW.part" bash "$SCRIPT" || CHECK_RC=$?
  fi
  cat "$RAW.part" >> "$RAW"
elif [ "$TIER" != edit ]; then
  echo "infra: $SCRIPT is missing. Run the harness-tailor skill to set up checks." >> "$RAW"
  CHECK_RC=3
fi

# 3. Workflow packs listed in WORKFLOWS (harness.conf) add their own checks for the tier. Each
# runs in place from whichever library has it; sync warns about names no library has. While a
# project-listed library isn't here (a submodule not checked out), a name that doesn't resolve may
# be in it: a tooling problem, not a skip. Stacks too (their shims would stop the tier scripts).
WF_RC=0
MISSING_NOTE="$(agents_missing_note)"
set -f   # the names are split on spaces; a glob character stays literal
if [ -n "$MISSING_NOTE" ]; then
  for st in ${STACKS:-}; do
    agents_resolve stacks "$st" >/dev/null && continue
    echo "infra: stack '$st' isn't available: $MISSING_NOTE" >> "$RAW"
    WF_RC=3
  done
fi
for wf in ${WORKFLOWS:-}; do
  if ! WD="$(agents_resolve workflows "$wf")"; then
    if [ -n "$MISSING_NOTE" ]; then
      echo "infra: workflow '$wf' isn't available: $MISSING_NOTE" >> "$RAW"
      WF_RC="$(agents_worst_rc "$WF_RC" 3)"
    fi
    continue
  fi
  WS="$WD/checks/$TIER.sh"
  [ -f "$WS" ] || continue
  rc=0
  agents_budget_run "$BUDGET" "$RAW.part" bash "$WS" ${FILES[@]+"${FILES[@]}"} || rc=$?
  # A pack's "note: " lines aren't findings: emit shows them under the status line, pass or fail.
  n="$NOTES" awk '/^note: / { print >> ENVIRON["n"]; next } { print }' "$RAW.part" >> "$RAW"
  WF_RC="$(agents_worst_rc "$WF_RC" "$rc")"
done
set +f

RC="$(agents_worst_rc "$GUARD_RC" "$LOCAL_RC" "$CHECK_RC" "$WF_RC")"
case "$RC" in
  0) WORD=ok ;;
  1) WORD=FAIL ;;
  2) WORD=BLOCK ;;
  3) WORD=INFRA ;;
  124) WORD=SKIP; echo "SKIP: out of budget (${BUDGET}s). Checks did not finish; nothing was verified." >> "$RAW" ;;
  *) WORD=FAIL ;;
esac

LOG=""
if [ "$RC" -ne 0 ]; then
  agents_shape "$RAW" > "$SHAPED"
  LOG="$(agents_log "verify-$TIER" "$RAW")"
fi

OUT="$(emit "$WORD" "$RC" "$SHAPED" "$LOG")"
printf '%s\n' "$OUT"
if [ -n "$KEY" ]; then
  printf '%s\n' "$OUT" > "$C.out"
  echo "$RC" > "$C.rc"
  echo "$KEY" > "$C.key"
fi
[ "$TIER" = edit ] || agents_backup quiet   # local mode: refresh the backup on the turn and full tiers
exit "$RC"
