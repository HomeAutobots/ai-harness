#!/usr/bin/env bash
# ai-harness: check. Harness-owned. Fast per-file checks on the files you just edited.
#   .agents/bin/check <files...>      same as: verify --tier=edit <files...>
# The post-edit hook runs this automatically in tools that support hooks.
# verify runs through bash when it's executable: macOS assesses a new executable on its first exec.
v="$(dirname "$0")/verify"
if [ -x "$v" ]; then exec bash "$v" --tier=edit "$@"; fi
exec "$v" --tier=edit "$@"
