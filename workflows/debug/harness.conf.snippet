# debug workflow (install.sh --workflow debug). harness-tailor fills these in.
# Where the playbook (playbook.md) and the sessions (sessions/<slug>/) live, repo-relative or
# absolute. Sessions stay local (the seeded .gitignore); the playbook is shared in team mode.
DEBUG_DIR=".agents/debug"
# Debugging workflows that are on: bug (test, crash, and field come later).
DEBUG_KINDS="bug"
# Where experiments must be gone before the root-cause check-in (space-separated globs).
DEBUG_SCOPE="**"
# Check-ins that need your approval (debug approve): rootcause. Empty means an agent review only.
DEBUG_ASK="rootcause"
